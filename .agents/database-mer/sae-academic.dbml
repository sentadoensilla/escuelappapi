Table public.tabinst {
  cinstcalendario varchar(8) []
  cinstcara int [note: 'Carácter (FK a tabcara).']
  cinstciud int [note: 'Ciudad (FK a tabciud).']
  cinstcodidane varchar(20) [note: 'Código DANE de la institución.']
  cinstcoordx real []
  cinstcoordy real []
  cinstdepa int [note: 'Departamento (FK a tabdepageog).']
  cinstdire text [not null, note: 'Dirección de la institución.']
  cinstemai text [note: 'Correo electrónico.']
  cinstescu text [not null, default: '\'archivos/instituciones/imagenes/escudo.jpg\'::text', note: 'Escudo de la institución.']
  cinstesta int [not null, default: '8', note: 'Estado (FK a tabestagene, 8=activo).']
  cinstfacebook text []
  cinstfirm varchar(100) [default: '\'archivos/instituciones/auto/blanco.jpg\'::character varying', note: 'Firma de la institución.']
  cinsthimno text []
  cinstid int [pk, not null, note: 'Identificador único de la institución.']
  cinstinstagram text []
  cinstlema text [note: 'Lema institucional.']
  cinstmanualconvivencia text []
  cinstnit text [note: 'NIT de la institución.']
  cinstnomb text [note: 'Nombre de la institución.']
  cinstpadre int [note: 'Institución padre (sedes).']
  cinstreconocimiento text []
  cinstresolrector text []
  cinsttele text [note: 'Teléfono.']
  cinsttiktok text []
  cinsttwitter text []
  cinstyoutube text []
  tabespeinst_cespeinstid int [not null, note: 'Especialidad (FK a tabespeinst).']
  tabmetoinst_cmetoinst int [not null, note: 'Método institucional (FK a tabmetoinst).']
  tabzonaresi_czonaresiid int [not null, note: 'Zona de residencia (FK a tabzonaresi).']
  Note: 'Instituciones educativas oficiales y extraoficiales.'
}

Table public.tabinstdoce {
  canolid int [not null, note: 'Año lectivo (FK a tabanol).']
  ccargid int [not null, note: 'Cargo (FK a tabcarg).']
  cdoceid int [not null, note: 'Docente (FK a tabdoce).']
  cinstdocearp int [note: 'ARP/riesgos (FK a tabempr).']
  cinstdocears int [note: 'ARS (FK a tabempr).']
  cinstdocecaja int [note: 'Caja de compensación (FK a tabempr).']
  cinstdoceeps int [note: 'EPS (FK a tabempr).']
  cinstdoceesta int [note: 'Estado (FK a tabestagene).']
  cinstdocefechfina date [note: 'Fecha de fin del contrato.']
  cinstdocefechinic date [note: 'Fecha de inicio del contrato.']
  cinstdocefechregi date [note: 'Fecha de registro.']
  cinstdoceid int [pk, not null, note: 'Identificador único del registro.']
  cinstdocesala int [note: 'Salario.']
  cinstid int [not null, note: 'Institución (FK a tabinst).']
  cjefearea int [default: '0', note: 'Si es jefe de área.']
  ctipovincid int [not null, note: 'Tipo de vinculación (FK a tabtipovinc).']
  Note: 'Docentes contratados en una institución en un año lectivo determinado (nómina).'
}

Table public.tabinstreso {
  cinstcolcar text [default: '\'58ACFA\'::text', note: 'Color/característica del recurso.']
  cinstdec int [default: '2', note: 'Cantidad de recursos.']
  cinstid int [not null, note: 'Institución (FK a tabinst).']
  cinstresodesc text [not null, note: 'Descripción del recurso.']
  cinstresoid int [pk, not null, note: 'Identificador único del recurso.']
  cinsttipar int [default: '1', note: 'Tipo de recurso.']
  Note: 'Recursos institucionales (inventario).'
}

Table public.tabinstsede {
  cinstid int [not null, note: 'Institución (FK a tabinst).']
  csedeid int [pk, not null, note: 'Identificador único de la sede.']
  csedenomb text [not null, note: 'Nombre de la sede.']
  Note: 'Sedes de las instituciones.'
}

Table public.tabjorn {
  cjorndesc varchar(20) [note: 'Descripción de la jornada.']
  cjornesta int [note: 'Estado.']
  cjornid int [pk, not null, note: 'Identificador único de la jornada.']
  Note: 'Jornadas oficiales (catálogo).'
}

Table public.tablogcomp {
  casigid int [not null, note: 'Asignatura (FK a tabasig).']
  ccompid int [not null, note: 'Competencia (FK a tabcomp).']
  ccontprogid int [note: 'Contenido programático (FK a tabcontprog).']
  cgradid int [not null, note: 'Grado (FK a tabgrad).']
  clogcompid int [pk, not null, default: 'nextval(\'tablogcomp_clogcompid_seq\'::regclass)', note: 'Identificador único del registro.']
  cnotafechregi timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  Note: 'Registro histórico de temas y competencias vistos.'
}

Table public.tabmatr {
  ccursid int [note: 'Curso (FK a tabcurs).']
  cestuid int [note: 'Estudiante (FK a tabestu).']
  cmatrdesc double [not null, default: '0', note: 'Valor de descuento.']
  cmatresta int [not null, default: '13', note: 'Estado de la matrícula (13=matriculado).']
  cmatrfech date [note: 'Fecha de la matrícula.']
  cmatrianopasacond int [note: 'Año en que aprobó condicionalmente.']
  cmatrianopasasitu int [note: 'Año en que aprobó su situación (FK a tabestacurs).']
  cmatrid int [pk, not null, note: 'Identificador único de la matrícula.']
  cmatrinst int [note: 'Institución de la matrícula.']
  cmatrirepi bool [default: 'false', note: 'Si es repitente.']
  cmatrnuevestu bool [default: 'false', note: 'Si es estudiante nuevo.']
  cmatrvaloinsc double [not null, default: '0', note: 'Valor de inscripción.']
  cmatrvalopens double [not null, default: '0', note: 'Valor de pensión.']
  indexes {
    (ccursid, cmatrinst, cestuid) [unique]
  }
  Note: 'Matrícula de todas las instituciones.'
}

Table public.tabmatrpago {
  cmatrid int [not null, note: 'Matrícula (FK a tabmatr).']
  cmatrpagoesta int [not null, note: 'Estado del pago.']
  cmatrpagofech date [not null, note: 'Fecha del pago.']
  cmatrpagoid int [pk, not null, note: 'Identificador único del pago.']
  cmatrpagoperi int [not null, note: 'Periodo del pago.']
  Note: 'Cumplimiento de pagos de los estudiantes matriculados.'
}

Table public.tabmetoinst {
  cmetoinstdesc text [note: 'Descripción del método.']
  cmetoinstesta int [note: 'Estado.']
  cmetoinstid int [pk, not null, note: 'Identificador único del método.']
  Note: 'Métodos institucionales oficiales (catálogo: escuela tradicional, escuela nueva, etc.).'
}

Table public.tabnota {
  asigcursid int [not null, note: 'Asignatura-curso (FK a asigcurs).']
  ccompid int [not null, note: 'Competencia evaluada (FK a tabcomp).']
  cmatrid int [not null, note: 'Matrícula (FK a tabmatr).']
  cnotaesta int [not null, default: '8', note: 'Estado de la nota (8=activo).']
  cnotafech date [not null, note: 'Fecha de la nota.']
  cnotafechregi timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  cnotaid int [pk, not null, default: 'nextval(\'tabnota_cnotaid_seq\'::regclass)', note: 'Identificador único de la nota.']
  cnotaobse text [note: 'Observación de la nota.']
  cnotavalo double [not null, note: 'Valor de la nota.']
  cperiid int [not null, note: 'Periodo académico.']
  indexes {
    (cperiid, asigcursid, ccompid, cmatrid, cnotaesta) [unique]
  }
  Note: 'Notas de un estudiante en una asignatura (por competencia y periodo).'
}

