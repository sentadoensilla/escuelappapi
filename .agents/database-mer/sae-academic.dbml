Table public.tabnotadef {
  asigcursid int [not null, note: 'Asignatura-curso (FK a asigcurs).']
  cmatrid int [not null, note: 'Matrícula (FK a tabmatr).']
  cnotadefesta int [not null, default: '8', note: 'Estado (8=activo).']
  cnotadeffech timestamp(6) without time zone [not null, note: 'Fecha del promedio.']
  cnotadeffechregi date [not null, note: 'Fecha de registro.']
  cnotadefid int [pk, not null, default: 'nextval(\'tabnota_cnotaid_seq\'::regclass)', note: 'Identificador único del promedio.']
  cnotadefobse text [note: 'Observación.']
  cnotadefvalo double [not null, note: 'Valor definitivo.']
  cperiid int [not null, note: 'Periodo académico.']
  ctipodeseid int [not null, note: 'Tipo de desempeño (FK a tabtipodese).']
  indexes {
    (cnotadefesta, cmatrid, asigcursid, cperiid, ctipodeseid) [unique]
  }
  Note: 'Promedios definitivos por asignatura/dimensión por periodo.'
}

Table public.tabnotahist {
  asigcursid int [not null, note: 'Asignatura-curso (FK a asigcurs).']
  ccompid int [not null, note: 'Competencia (FK a tabcomp).']
  cmatrid int [not null, note: 'Matrícula (FK a tabmatr).']
