Ref: observador.tabobsplan.cinstid > public.tabinst.cinstid // tabobsplan_cobsplanid_fkey
Ref: observador.tabresp.cinstid > public.tabinst.cinstid // tabresp_cinstid_fkey
Ref: observador.tabrespeval.cmatrid > public.tabmatr.cmatrid // tabrespeval_cmatrid_fkey
Ref: observador.tabrespeval.crespsubid > observador.tabrespsub.crespsubid // tabrespeval_crespsubid_fkey
