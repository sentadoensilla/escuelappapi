  cpromfin double [not null, note: 'Promedio final.']
  cpromoesta int [note: 'Estado.']
  cpromoid int [pk, not null, note: 'Identificador único del promedio.']
  Note: 'Promedios generales de cada estudiante (con reglas de promoción).'
}

Table public.tabresg {
