  cperivalesta int [not null, note: 'Estado.']
  cperivalid int [pk, not null, note: 'Identificador único del valor.']
  Note: 'Valores (etiquetas) para cada periodo académico.'
}

Table public.tabpromasig {
  asigcursid int [not null, note: 'Asignatura-curso (FK a asigcurs).']
  canolid int [not null, note: 'Año lectivo (FK a tabanol).']
  careaid int [not null, note: 'Área (FK a tabarea).']
  cpromasigesta int [not null, default: '1', note: 'Estado (1=activo).']
  cpromasigid int [not null, default: 'nextval(\'tabpromasig_cpromasigid_seq\'::regclass)', note: 'Identificador único del promedio.']
  cpromasigpond double [not null, note: 'Ponderación de la asignatura.']
  cpromasigprom double [not null, note: 'Promedio de la asignatura.']
  cpromoid int [not null, note: 'Promedio general (FK a tabpromo).']
  Note: 'Promedio por asignatura: calculado para el promedio general del estudiante.'
}

Table public.tabpromdef {
  cmatrid int [not null, note: 'Matrícula (FK a tabmatr).']
  cperiid int [not null, note: 'Periodo (FK a anolperi).']
  cpromdefesta int [not null, default: '8', note: 'Estado (8=activo).']
  cpromdefid int [pk, not null, note: 'Identificador único del promedio.']
  cpromdefvalo double [not null, note: 'Valor del promedio.']
  ctipopromid int [not null, note: 'Tipo de promedio.']
  indexes {
    (cpromdefesta, cperiid, cmatrid) [unique]
  }
  Note: 'Promedios definitivos por matrícula y por periodo.'
}

Table public.tabpromo {
  cgradodesde int [not null, note: 'Grado desde.']
  cgradopara int [not null, note: 'Grado para.']
