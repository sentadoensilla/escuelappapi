  ccompdesc text [not null, note: 'Descripción de la competencia.']
  ccompesta int [default: '8', note: 'Estado de la competencia (8=activo).']
  ccompid int [not null, note: 'Identificador único de la competencia.']
  ccompobse text [note: 'Observación de la competencia.']
  ccomptipid int [default: '1', note: 'Tipo de competencia.']
  cgradid text [not null, note: 'Grado al que aplica.']
  cinstid int [default: '0', note: 'Institución (0=global).']
  Note: 'Competencias/indicadores de desempeño (logros) por área y grado.'
}

Table public.tabcompestu {
  asigcurscompid int [not null, note: 'Competencia de la asignatura-curso (FK a asigcurscomp).']
  ccompestuesta int [not null, default: '8', note: 'Estado del logro (8=activo).']
  ccompestufechregi timestamp [not null, note: 'Fecha de registro.']
  ccompestuid int [not null, default: 'nextval(\'tabcompestu_ccompestuid_seq\'::regclass)', note: 'Identificador único del logro.']
  cmatrid int [not null, note: 'Matrícula del estudiante (FK a tabmatr).']
  cperiid int [not null, note: 'Periodo académico.']
  indexes {
    (ccompestuesta, cmatrid, cperiid, asigcurscompid) [unique]
  }
  Note: 'Logros otorgados a un estudiante en una asignatura de un curso durante un periodo.'
}

Table public.tabconf {
