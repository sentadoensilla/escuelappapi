  cavisusuafechinic date [not null, note: 'Fecha de inicio de vigencia.']
  cavisusuafechregi timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  cavisusuaid int [pk, not null, note: 'Identificador único del aviso.']
  cavisusuaimag text [not null, note: 'Imagen del aviso.']
  cavisusuatitu text [not null, note: 'Título del aviso.']
  Note: 'Avisos para mostrar en la bandeja de entrada de cada usuario.'
}

