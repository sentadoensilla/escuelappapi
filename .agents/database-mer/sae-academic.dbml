  cnotaobse text [note: 'Observación.']
  cnotavalo double [not null, note: 'Valor de la nota.']
  cperiid int [not null, note: 'Periodo.']
  indexes {
    (asigcursid, ccompid, cperiid, cmatrid, cnotaesta) [unique]
  }
