Project bdsae2 {
  database_type: 'PostgreSQL'
  Note: 'Integración y migración: integration (tabenla/tabregiacti) + migracion (map_*).'
}

Table integration.tabenla {
  cenladesc text [not null, note: 'Descripción/tabla de destino del enlace.']
  cenladesccamp text [not null, note: 'Campo(s) de la tabla de destino usados en el enlace.']
  cenladescextr text [not null, note: 'Campos adicionales (extra) para la visualización en el enlace.']
  cenlaesta int [not null, note: 'Estado del enlace.']
  cenlaid int [pk, not null, note: 'Identificador único del enlace.']
  Note: 'Mapeo de enlace entre los esquemas SAE (public/logic) y la agenda (Escuelapp): describe los campos con los que se hace el enlace.'
}

Table integration.tabregiacti {
  cregiactifech date [not null, note: 'Fecha de la actividad.']
  cregiactihora time [not null, note: 'Hora de la actividad.']
  cregiactiid real [pk, not null, note: 'Identificador único del registro de actividad.']
  cregiactiip varchar(15) [note: 'Dirección IP del usuario.']
  cregiactinave varchar(16) [note: 'Navegador usado por el usuario.']
  cregiactiregi text [not null, note: 'Descripción del registro/acción realizada.']
  cregiactisecu varchar(14) [not null, note: 'Secuencia/código de la actividad.']
  cusuaid int [not null, note: 'Usuario que realizó la actividad.']
  Note: 'Registro de actividades de los usuarios en la aplicación (auditoría).'
}

Table migracion.map_docente {
  aedocentes_id double [pk, not null]
  cdoceid int [not null]
}

Table migracion.map_estudiante {
  aeestudiantes_id int [pk, not null]
  cestuid int [not null]
}

Table migracion.map_institucion {
  aeinst_id double [pk, not null]
  cinstid int [not null]
}

Table migracion.map_rol {
  aeroll_id int [not null]
  crollid int [pk, not null]
}

Table migracion.map_usuario {
  aeusu_id double [not null]
  cusuaid int [pk, not null]
}
