  aeacudientes_empresatelefono varchar(255) [note: 'Teléfono de la empresa.']
  aeacudientes_id int [not null, default: 'nextval(\'data.aematriculas_acudientes_aeacudientes_id_seq\'::regclass)', note: 'Identificador único del acudiente.']
  aeacudientes_identificacion varchar(16) [not null, note: 'Identificación.']
