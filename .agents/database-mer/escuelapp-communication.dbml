  aelogdispositivos_model text [note: 'Modelo del dispositivo.']
  aelogdispositivos_platform text [note: 'Plataforma (Android/iOS/web).']
  aelogdispositivos_serial text [note: 'Serial del dispositivo.']
  aelogdispositivos_state text [not null, note: 'Estado de la acción.']
  aelogdispositivos_target text [note: 'Destino/acción realizada.']
  aelogdispositivos_uuid text [note: 'UUID del dispositivo.']
  aelogdispositivos_version text [note: 'Versión de la app.']
  aeusu_id double [not null, note: 'Usuario.']
  Note: 'Log de accesos/dispositivos de los usuarios.'
}

Table data.aematriculas_academia {
  aeestudiantes_id int [note: 'Estudiante (FK a aematriculas_estudiantes).']
  aeestudiantesacademia_colegio_caracter smallint [note: 'Carácter del colegio anterior (FK a aecaracter).']
  aeestudiantesacademia_colegio_ciudad smallint [note: 'Ciudad del colegio anterior.']
  aeestudiantesacademia_colegio_pais smallint [note: 'País del colegio anterior.']
  aeestudiantesacademia_colegio_provincia smallint [note: 'Provincia del colegio anterior.']
  aeestudiantesacademia_conocernos smallint [note: 'Cómo conoció la institución (FK a aeconocer).']
  aeestudiantesacademia_conocernos_otro varchar(255) [note: 'Otra forma de conocer la institución.']
  aeestudiantesacademia_gradomatricula smallint [not null, note: 'Grado al que se matricula.']
  aeestudiantesacademia_id int [not null, default: 'nextval(\'data.aematriculas_academia_aeestudiantesacademia_id_seq\'::regclass)', note: 'Identificador único del registro.']
  aeestudiantesacademia_nuevo bool [note: 'Si es estudiante nuevo.']
  aeestudiantesacademia_repitente bool [not null, note: 'Si es repitente.']
