Project bdsae2 {
  database_type: 'PostgreSQL'
  Note: 'Dominio de comunicación Escuelapp: data (agenda) + contact (WhatsApp/plantillas).'
}

Table contact.aetempmess {
  aetempmess_estado int [default: '1', note: 'Estado de la plantilla (1=activo).']
  aetempmess_guia text [not null, note: 'Guía/instructivo asociado al mensaje.']
  aetempmess_id int [pk, not null, default: 'nextval(\'contact.aetempmess_aetempmess_id_seq\'::regclass)', note: 'Identificador único de la plantilla.']
  aetempmess_text text [not null, note: 'Texto de la plantilla del mensaje.']
  aetempmess_type int [not null, note: 'Tipo de mensaje al que pertenece (FK a aetempmesstype).']
  Note: 'Plantillas de mensaje de WhatsApp para envíos generales (con guía de destino).'
}

Table contact.aetempmesssede {
  aeinst_id bigint [not null, note: 'Institución a la que aplica la plantilla (FK a data.aeinstituciones).']
  aetempmesssede_estado int [default: '1', note: 'Estado de la plantilla (1=activo).']
  aetempmesssede_guia text [not null, note: 'Guía/instructivo asociado al mensaje de la sede.']
  aetempmesssede_id int [pk, not null, default: 'nextval(\'contact.aetempmesssede_aetempmesssede_id_seq\'::regclass)', note: 'Identificador único del registro.']
  aetempmesssede_text text [not null, note: 'Texto de la plantilla del mensaje de la sede.']
  aetempmesstype_id int [not null, note: 'Tipo de mensaje al que pertenece (FK a aetempmesstype).']
  Note: 'Plantillas de mensaje de WhatsApp específicas por institución (sede), reemplazan a las generales.'
}

Table contact.aetempmesstype {
  aetempmesstype_estado int [default: '1', note: 'Estado del tipo de mensaje (1=activo).']
  aetempmesstype_id int [pk, not null, default: 'nextval(\'contact.aetempmesstype_aetempmesstype_id_seq\'::regclass)', note: 'Identificador único del tipo de mensaje.']
  aetempmesstype_text text [not null, note: 'Texto del tipo de mensaje.']
  Note: 'Tipos de mensaje/plantilla de WhatsApp disponibles para envío (cada tipo se asocia a un emisor).'
}

Table contact.aetempmessvars {
  aetempmessvars_comentario text [not null, note: 'Descripción del uso de la variable en las plantillas.']
  aetempmessvars_estado int [default: '1', note: 'Estado de la variable (1=activo).']
  aetempmessvars_id int [pk, not null, default: 'nextval(\'contact.aetempmessvars_aetempmessvars_id_seq\'::regclass)', note: 'Identificador único de la variable.']
  aetempmessvars_nombre varchar(19) [not null, note: 'Nombre de la variable (ej. {{nombre_estudiante}}).']
  Note: 'Variables (placeholders) reemplazables dentro de las plantillas de mensaje de WhatsApp.'
}

Table contact.emisor {
  emisor varchar(14) [not null, note: 'Número de teléfono del emisor de WhatsApp.']
  estado int [not null, default: '6', note: 'Estado del emisor (FK a data.aeestados).']
  fecharegistro timestamp [default: 'CURRENT_TIMESTAMP', note: 'Fecha y hora de registro del emisor.']
  idemisor int [pk, not null, default: 'nextval(\'contact.emisor_idemisor_seq\'::regclass)', note: 'Identificador único del emisor.']
  idempresa bigint [not null, note: 'Institución dueña del número de WhatsApp (FK a data.aeinstituciones).']
  token text [note: 'Token de sesión/autenticación del emisor en WhatsApp.']
  Note: 'Cuentas/emisores de WhatsApp por institución: número desde el cual se envían los mensajes y su token de sesión.'
}

Table data.aeacudientes {
  aeacudientes_id int [pk, not null, note: 'Identificador único del acudiente.']
  aeestudiantes_apellidosacudiente varchar(64) [note: 'Apellidos del acudiente.']
  aeestudiantes_direccionacudiente text [note: 'Dirección del acudiente.']
  aeestudiantes_estado int [default: '1', note: 'Estado del acudiente (1=activo).']
  aeestudiantes_fecharegistro timestamp [default: 'CURRENT_TIMESTAMP', note: 'Fecha de registro.']
  aeestudiantes_fotoacudiente text [note: 'Foto del acudiente.']
  aeestudiantes_generoacudiente char(1) [note: 'Género del acudiente.']
  aeestudiantes_id double [note: 'Estudiante asociado (FK a aeestudiantes).']
  aeestudiantes_idenacudiente varchar(16) [note: 'Identificación del acudiente.']
  aeestudiantes_mailacudiente text [note: 'Correo del acudiente.']
  aeestudiantes_nombresacudiente varchar(64) [note: 'Nombres del acudiente.']
  aeestudiantes_telefonoacudiente text [note: 'Teléfono del acudiente.']
  aeusu_id double [note: 'Usuario de login asociado (FK a engine.aeusu).']
  Note: 'Acudientes (padres/tutores) de los estudiantes.'
}

Table data.aeacudientes_old {
  aeacudientes_id int [pk, not null, note: 'Identificador del acudiente.']
  aeestudiantes_apellidosacudiente varchar(64) [note: 'Apellidos.']
  aeestudiantes_direccionacudiente text [note: 'Dirección.']
  aeestudiantes_estado int [default: '1', note: 'Estado.']
  aeestudiantes_fecharegistro timestamp [not null, note: 'Fecha de registro.']
  aeestudiantes_fotoacudiente text [note: 'Foto.']
  aeestudiantes_generoacudiente char(1) [note: 'Género.']
  aeestudiantes_id double [note: 'Estudiante asociado.']
  aeestudiantes_idenacudiente varchar(16) [note: 'Identificación.']
  aeestudiantes_mailacudiente text [not null, note: 'Correo.']
  aeestudiantes_nombresacudiente varchar(64) [note: 'Nombres.']
  aeestudiantes_telefonoacudiente text [not null, note: 'Teléfono.']
  aeusu_id double [note: 'Usuario de login.']
  Note: 'Copia/backup de acudientes.'
}

Table data.aeano {
  aeano_calendario char [default: '\'z\'::"char"', note: 'Calendario (A/B) del año lectivo.']
  aeano_descripcion varchar(16) [note: 'Descripción del año lectivo (ej. "2026").']
  aeano_id int [pk, not null, note: 'Identificador único del año lectivo.']
  fecha_fin date [note: 'Fecha de finalización del año lectivo.']
  fecha_inicio date [note: 'Fecha de inicio del año lectivo.']
  Note: 'Años lectivos para todas las sedes/instituciones en general.'
}

Table data.aeasignaciones {
  aeanol_id int [not null, note: 'Año lectivo (FK a aeano).']
  aeasignaciones_asignatura varchar(256) [not null, note: 'Nombre de la asignatura.']
  aeasignaciones_dia int [not null, note: 'Día de la semana (índice) de la clase.']
  aeasignaciones_enlace text [note: 'Enlace virtual de la clase.']
  aeasignaciones_estado int [default: '1', note: 'Estado de la asignación (1=activo).']
  aeasignaciones_grupo varchar(64) [not null, note: 'Grupo/salón al que se dicta.']
  aeasignaciones_hora time [not null, note: 'Hora de inicio de la clase.']
  aeasignaciones_horafin time [note: 'Hora de fin de la clase.']
  aeasignaciones_id double [not null, default: 'nextval(\'data.secuence_aeasignaciones_id\'::regclass)', note: 'Identificador único de la asignación.']
  aeasignaciones_utiles varchar(256) [note: 'Útiles/materiales requeridos.']
  aedocentes_id double [not null, note: 'Docente a cargo (FK a aedocentes).']
  aeinst_id double [not null, note: 'Institución (FK a aeinstituciones).']
  Note: 'Asignaciones académicas: asignatura + docente + grupo + horario.'
}

Table data.aeasistencias {
  aeasignaciones_asignatura varchar(64) [not null, note: 'Asignatura.']
  aeasistencia_id double [pk, not null, note: 'Identificador único del registro de asistencia.']
  aeasistencias_docente double [not null, note: 'Docente que registra (FK a aedocentes).']
  aeasistencias_enviado bool [default: 'false', note: 'Si la notificación fue enviada.']
  aeasistencias_estado int [default: '1', note: 'Estado (1=activo).']
  aeasistencias_fecha date [not null, note: 'Fecha de la asistencia.']
  aeasistencias_fecharegistro timestamptz [note: 'Fecha de registro.']
  aeasistencias_llego int [note: 'Indicador de si llegó/asistió.']
  aeestudiantes_grupo varchar(32) [not null, note: 'Grupo/salón.']
  aeestudiantes_id double [not null, note: 'Estudiante (FK a aeestudiantes).']
  Note: 'Asistencias de los estudiantes registradas por los docentes.'
}

Table data.aeavisos {
  aeanol_id bigint [not null, note: 'Año lectivo (FK a aeano).']
  aeavisos_aceptarespuestas bool [default: 'true', note: 'Si acepta respuestas o no.']
  aeavisos_adjunto text [note: 'Archivo adjunto.']
  aeavisos_alcance int [default: '1', note: 'Alcance: 0=docentes, 1=docentes y estudiantes.']
  aeavisos_descripcion text [not null, note: 'Descripción/cuerpo del aviso.']
  aeavisos_estado int [default: '1', note: 'Estado del aviso (1=activo).']
  aeavisos_estudiantesid text [note: 'Estudiantes específicos a los que va dirigido.']
  aeavisos_fecha timestamp [not null, note: 'Fecha de creación del aviso.']
  aeavisos_fechafinalizacion timestamp [not null, note: 'Fecha de finalización/vencimiento.']
  aeavisos_fechapublicacion timestamp [not null, note: 'Fecha de publicación.']
  aeavisos_grupo varchar[] [note: 'Grupos/salones a los que va dirigido.']
  aeavisos_id bigint [pk, not null, note: 'Identificador único del aviso.']
  aeavisos_titulo text [not null, note: 'Título del aviso.']
  aeinst_id bigint [not null, note: 'Institución (FK a aeinstituciones).']
  aeusu_id bigint [not null, note: 'Usuario autor (FK a engine.aeusu).']
  Note: 'Avisos/comunicados publicados por docentes para estudiantes y/o acudientes.'
}

Table data.aeavisos_comentarios {
  aeavisos_id bigint [not null, note: 'Aviso al que pertenece (FK a aeavisos).']
  aeavisoscomentarios_descripcion text [not null, note: 'Texto del comentario.']
  aeavisoscomentarios_estado int [default: '1', note: 'Estado del comentario (1=activo).']
  aeavisoscomentarios_fecha timestamp [not null, note: 'Fecha del comentario.']
  aeavisoscomentarios_id bigint [pk, not null, note: 'Identificador único del comentario.']
  aeusu_id bigint [not null, note: 'Usuario que comenta.']
  Note: 'Comentarios/respuestas a los avisos.'
}

Table data.aeavisosinternal {
  aeanol_id double [not null, note: 'Año lectivo.']
  aeavisosinternal_adjunto text [note: 'Archivo adjunto.']
  aeavisosinternal_descripcion text [not null, note: 'Descripción.']
  aeavisosinternal_docentessid text [note: 'Docentes destinatarios.']
  aeavisosinternal_estado int [default: '1', note: 'Estado (1=activo).']
  aeavisosinternal_fecha timestamp [not null, note: 'Fecha de creación.']
  aeavisosinternal_fechafinalizacion timestamp [not null, note: 'Fecha de finalización.']
  aeavisosinternal_fechapublicacion timestamp [not null, note: 'Fecha de publicación.']
  aeavisosinternal_id double [pk, not null, note: 'Identificador único del aviso interno.']
  aeavisosinternal_titulo text [not null, note: 'Título.']
  aeinst_id double [not null, note: 'Institución.']
  aeusu_id double [not null, note: 'Usuario autor.']
  Note: 'Avisos internos dirigidos solo a docentes.'
}

Table data.aeavisosinternal_comentarios {
  aeavisosinternal_id double [not null, note: 'Aviso interno (FK a aeavisosinternal).']
  aeavisosinternalcomentarios_descripcion text [not null, note: 'Texto del comentario.']
  aeavisosinternalcomentarios_estado int [default: '1', note: 'Estado (1=activo).']
  aeavisosinternalcomentarios_fecha timestamp [not null, note: 'Fecha del comentario.']
  aeavisosinternalcomentarios_id double [pk, not null, note: 'Identificador único del comentario.']
  aeusu_id double [not null, note: 'Usuario que comenta.']
  Note: 'Comentarios a los avisos internos.'
}

Table data.aeayuda {
  aeayuda_descripcion text [not null, note: 'Descripción de la ayuda.']
  aeayuda_enlace text [not null, note: 'Enlace de la ayuda.']
  aeayuda_estado int [default: '1', note: 'Estado (1=activo).']
  aeayuda_id double [pk, not null, note: 'Identificador único de la ayuda.']
  aeayuda_para text [not null, note: 'Roles a los que va dirigida.']
  aeayuda_tipointerface varchar(4) [not null, note: 'Tipo de interfaz (web/móvil).']
  aeayuda_titulo text [not null, note: 'Título de la ayuda.']
  aeayuda_version varchar(9) [note: 'Versión de la ayuda.']
  aeayuda_vistas int [note: 'Número de vistas de la ayuda.']
  Note: 'Ayudas/tutoriales del sistema (por rol, interfaz y versión).'
}

Table data.aebitacora {
  aeanol_id double [not null, note: 'Año lectivo.']
  aebitacora_asignatura text [note: 'Asignatura.']
  aebitacora_aviso bool [note: 'Si genera aviso/comunicado.']
  aebitacora_descripcion text [note: 'Descripción de la actividad/observación.']
  aebitacora_estudiantesid text [note: 'Estudiantes a los que aplica.']
  aebitacora_fecha timestamp [not null, note: 'Fecha del registro.']
  aebitacora_grupo varchar[] [note: 'Grupos a los que aplica.']
  aebitacora_id double [pk, not null, note: 'Identificador único del registro de bitácora.']
  aeinst_id double [not null, note: 'Institución.']
  aeusu_id double [not null, note: 'Docente que registra (FK a engine.aeusu).']
  Note: 'Bitácora de clases: registro diario de actividades y observaciones por docente.'
}

Table data.aebitacora_comentarios {
  aebitacora_id double [not null, note: 'Registro de bitácora (FK a aebitacora).']
  aebitacoracomentarios_descripcion text [not null, note: 'Texto del comentario.']
  aebitacoracomentarios_estado int [default: '1', note: 'Estado (1=activo).']
  aebitacoracomentarios_fecha timestamp [not null, note: 'Fecha del comentario.']
  aebitacoracomentarios_id double [pk, not null, note: 'Identificador único del comentario.']
  aeusu_id double [not null, note: 'Usuario que comenta.']
  Note: 'Comentarios a los registros de bitácora.'
}

Table data.aecaracter {
  aecaracter_descripcion varchar(16) [not null, note: 'Descripción del carácter (Público/Privado).']
  aecaracter_estado smallint [default: '1', note: 'Estado (1=activo).']
  aecaracter_id smallint [not null, note: 'Identificador único del carácter.']
  Note: 'Carácter de la institución (público/privado).'
}

Table data.aecitaciones {
  aeanol_id bigint [not null, note: 'Año lectivo (FK a aeano).']
  aecitacion_adjunto text [note: 'Archivo adjunto.']
  aecitacion_descripcion text [note: 'Descripción de la citación.']
  aecitacion_estado smallint [not null, note: 'Estado de la citación.']
  aecitacion_fecha timestamp [not null, note: 'Fecha y hora de la citación.']
  aecitacion_fecharegistro timestamp [not null, note: 'Fecha de registro de la citación.']
  aecitacion_id int [pk, not null, note: 'Identificador único de la citación.']
  aecitacion_lugar varchar [not null, note: 'Lugar de la citación.']
  aedocentes_id bigint [note: 'Docente que cita.']
  aeestudiantes_id text [not null, note: 'Estudiantes citados.']
  aeinst_id bigint [not null, note: 'Institución (FK a aeinstituciones).']
  aemotivo_id bigint [not null, note: 'Motivo de la citación (FK a aemotivo).']
  Note: 'Citaciones a acudientes/estudiantes por motivos de disciplina.'
}

Table data.aecondiciones {
  aecondiciones_acudiente text [not null, note: 'Acudiente que acepta.']
  aecondiciones_fecha timestamp [not null, note: 'Fecha de aceptación.']
  aecondiciones_id double [pk, not null, note: 'Identificador único del registro.']
  aelogdispositivos_model text [note: 'Modelo del dispositivo.']
  aelogdispositivos_platform text [note: 'Plataforma.']
  aelogdispositivos_serial text [note: 'Serial del dispositivo.']
  aelogdispositivos_uuid text [note: 'UUID del dispositivo.']
  aelogdispositivos_version text [note: 'Versión de la app.']
  Note: 'Aceptación de términos y condiciones por parte de los acudientes (registro del dispositivo).'
}

Table data.aeconocer {
  aeconocer_descripcion varchar(64) [not null, note: 'Descripción del medio (Redes sociales, Referidos, etc.).']
  aeconocer_estado smallint [default: '1', note: 'Estado (1=activo).']
  aeconocer_id smallint [not null, note: 'Identificador único del medio.']
  Note: 'Medios por los que se conoció la institución (encuesta de matrícula).'
}

Table data.aeconsultasdocentes {
  aeanol_id double [not null, note: 'Año lectivo.']
  aeasignaciones_asignatura text [not null, note: 'Asignatura sobre la que se consulta.']
  aeconsultasdocentes_descripcion text [not null, note: 'Texto de la consulta.']
  aeconsultasdocentes_estado int [default: '1', note: 'Estado (1=activo).']
  aeconsultasdocentes_fecha timestamp [not null, note: 'Fecha de la consulta.']
  aeconsultasdocentes_id double [pk, not null, note: 'Identificador único de la consulta.']
  aeconsultasdocentes_visibilidad bool [default: 'false', note: 'Si la consulta es visible.']
  aedocente_id double [not null, note: 'Docente destinatario (FK a aedocentes).']
  aeestudiantes_id double [not null, note: 'Estudiante que consulta (FK a aeestudiantes).']
  aeinst_id double [not null, note: 'Institución.']
  Note: 'Consultas de estudiantes/acudientes a los docentes.'
}

Table data.aeconsultasdocentes_comentarios {
  aeconsultasdocentes_id double [not null, note: 'Consulta (FK a aeconsultasdocentes).']
  aeconsultasdocentescomentarios_descripcion text [not null, note: 'Texto del comentario.']
  aeconsultasdocentescomentarios_estado int [default: '1', note: 'Estado (1=activo).']
  aeconsultasdocentescomentarios_fecha timestamp [not null, note: 'Fecha del comentario.']
  aeconsultasdocentescomentarios_id double [pk, not null, note: 'Identificador único del comentario.']
  aeusu_id double [not null, note: 'Usuario que comenta.']
  Note: 'Comentarios/respuestas a las consultas de docentes.'
}

Table data.aecronograma {
  aeano_id bigint [not null, note: 'Año lectivo.']
  aecronograma_adjunto text [note: 'Archivo adjunto.']
  aecronograma_descripcion text [not null, note: 'Descripción del evento.']
  aecronograma_estado int [default: '1', note: 'Estado (1=activo).']
  aecronograma_fechafin timestamp [note: 'Fecha de fin del evento.']
  aecronograma_fechainicio timestamp [not null, note: 'Fecha de inicio del evento.']
  aecronograma_fecharegistro timestamp [not null, default: 'CURRENT_TIMESTAMP', note: 'Fecha de registro.']
  aecronograma_grupo varchar[] [note: 'Grupos a los que aplica.']
  aecronograma_id int [not null, default: 'nextval(\'data.aecronograma_aecronograma_id_seq\'::regclass)', note: 'Identificador único del evento.']
  aecronograma_responsables text [note: 'Responsables del evento.']
  aecronograma_titulo text [not null, note: 'Título del evento.']
  aecronogramatipoevento_id int [default: '1', note: 'Tipo de evento (FK a aecronograma_tipoevento).']
  aeinst_id text [not null, note: 'Instituciones a las que aplica.']
  aeusu_id bigint [not null, note: 'Usuario autor.']
  Note: 'Cronograma de eventos institucionales (académicos, directivos, etc.).'
}

Table data.aecronograma_alerta {
  aecronograma_id bigint [not null, note: 'Evento (FK a aecronograma).']
  aecronogramaalerta_fecha timestamp [not null, default: 'CURRENT_TIMESTAMP', note: 'Fecha de la alerta.']
  aecronogramaalerta_id int [not null, default: 'nextval(\'data.aecronograma_alerta_aecronogramaalerta_id_seq\'::regclass)', note: 'Identificador único de la alerta.']
  Note: 'Alertas/recordatorios de eventos del cronograma.'
}

Table data.aecronograma_comentarios {
  aecronograma_id bigint [not null, note: 'Evento (FK a aecronograma).']
  aecronogramacomentario_descripcion text [not null, note: 'Texto del comentario.']
  aecronogramacomentario_fecha timestamp [default: 'CURRENT_TIMESTAMP', note: 'Fecha del comentario.']
  aecronogramacomentario_id int [not null, default: 'nextval(\'data.aecronograma_comentarios_aecronogramacomentario_id_seq\'::regclass)', note: 'Identificador único del comentario.']
  aeusu_id bigint [not null, note: 'Usuario que comenta.']
  Note: 'Comentarios a los eventos del cronograma.'
}

Table data.aecronograma_tipoevento {
  aecronogramatipoevento_color varchar(8) [default: '\'#FBB919\'::character varying', note: 'Color asociado al tipo de evento.']
  aecronogramatipoevento_descripcion text [not null, note: 'Descripción del tipo de evento.']
  aecronogramatipoevento_estado int [not null, default: '1', note: 'Estado (1=activo).']
  aecronogramatipoevento_id int [not null, default: 'nextval(\'data.aecronograma_tipoevento_aecronogramatipoevento_id_seq\'::regclass)', note: 'Identificador único del tipo de evento.']
  Note: 'Tipos de evento del cronograma (académica, directiva, financiera, etc.).'
}

Table data.aecue {
  aecue_asignatura text [note: 'Asignatura(s) a la que aplica.']
  aecue_descripcion text [not null, note: 'Descripción de la evaluación.']
  aecue_estado bool [default: 'true', note: 'Estado (true=activo).']
  aecue_fechacreacion timestamp [not null, note: 'Fecha de creación.']
  aecue_id int [not null, note: 'Identificador único de la evaluación.']
  aecue_imagen varchar(256) [note: 'Imagen de la evaluación.']
  aecue_nombre varchar(128) [not null, note: 'Nombre de la evaluación.']
  Note: 'Evaluaciones/cuestionarios (bancos de preguntas).'
}

Table data.aediscapacidades {
  aediscapacidades_descripcion varchar(32) [not null, note: 'Descripción de la discapacidad.']
  aediscapacidades_estado int [default: '1', note: 'Estado (1=activo).']
  aediscapacidades_id int [pk, not null, note: 'Identificador único de la discapacidad.']
  Note: 'Discapacidades reconocidas (catálogo).'
}

Table data.aedocentes {
  aedocentes_apellidos varchar(64) [not null, note: 'Apellidos del docente.']
  aedocentes_direccion varchar(128) [note: 'Dirección.']
  aedocentes_estado int [default: '1', note: 'Estado del docente (1=activo).']
  aedocentes_experiencia text [note: 'Experiencia laboral 1.']
  aedocentes_experiencia2 text [note: 'Experiencia laboral 2.']
  aedocentes_experiencia3 text [note: 'Experiencia laboral 3.']
  aedocentes_experiencia4 text [note: 'Experiencia laboral 4.']
  aedocentes_fechanacimiento date [note: 'Fecha de nacimiento.']
  aedocentes_foto varchar(128) [note: 'Foto del docente.']
  aedocentes_genero char(1) [note: 'Género del docente.']
  aedocentes_id double [pk, not null, default: 'nextval(\'data.secuence_aedocentes_id\'::regclass)', note: 'Identificador único del docente.']
  aedocentes_identificacion varchar(32) [not null, note: 'Documento de identificación del docente.']
  aedocentes_mail varchar(128) [note: 'Correo electrónico (único).']
  aedocentes_nombres varchar(64) [not null, note: 'Nombres del docente.']
  aedocentes_telefono varchar(32) [note: 'Teléfono.']
  aedocentes_titulo varchar(128) [note: 'Título académico 1.']
  aedocentes_titulo2 varchar(128) [note: 'Título académico 2.']
  aedocentes_titulo3 varchar(128) [note: 'Título académico 3.']
  aedocentes_titulo4 varchar(128) [note: 'Título académico 4.']
  aedocentes_url text [note: 'URL/perfil en línea del docente.']
  aeusu_id double [not null, note: 'Usuario de login asociado (FK a engine.aeusu).']
  Note: 'Docentes (usuarios docentes de la agenda).'
}

Table data.aeeps {
  aeeps_administradora varchar(255) [note: 'Administradora de la EPS.']
  aeeps_codigo varchar(12) [note: 'Código de la EPS.']
  aeeps_estado smallint [default: '1', note: 'Estado de la EPS.']
  aeeps_id int [pk, not null, note: 'Identificador único de la EPS.']
  aeeps_nit varchar(12) [note: 'NIT de la EPS.']
  aeeps_nombre varchar(255) [not null, note: 'Nombre de la EPS.']
  aeeps_tipo varchar(12) [note: 'Tipo de la EPS.']
  Note: 'EPS (entidades de salud) para afiliación de estudiantes.'
}

Table data.aeestados {
  aeestados_descripcion varchar(20) [note: 'Descripción del estado (Activo, Inactivo, etc.).']
  aeestados_icons varchar(64) [note: 'Icono asociado al estado.']
  aeestados_id int [pk, not null, note: 'Identificador único del estado.']
  aeestados_style varchar(64) [note: 'Estilo CSS asociado al estado.']
  Note: 'Estados generales usados en los registros de todas las tablas.'
}

Table data.aeestudiantes {
  aeacudientes_id bigint [note: 'Acudiente asociado (FK a aeacudientes).']
  aeano_id int [not null, note: 'Año lectivo (FK a aeano).']
  aeestudiantes_apellidos varchar(64) [not null, note: 'Apellidos del estudiante.']
  aeestudiantes_codigo varchar(32) [note: 'Código del estudiante.']
  aeestudiantes_direccion text [note: 'Dirección.']
  aeestudiantes_estado int [default: '8', note: 'Estado del estudiante (FK a aeestados).']
  aeestudiantes_fechanacimiento date [note: 'Fecha de nacimiento.']
  aeestudiantes_fecharegistro timestamp [default: 'CURRENT_TIMESTAMP', note: 'Fecha de registro.']
  aeestudiantes_genero char(1) [note: 'Género del estudiante.']
  aeestudiantes_grupo varchar(32) [not null, note: 'Grupo/salón del estudiante.']
  aeestudiantes_id int [pk, not null, note: 'Identificador único del estudiante.']
  aeestudiantes_identificacion varchar(32) [note: 'Documento de identificación.']
  aeestudiantes_mail text [note: 'Correo electrónico del estudiante.']
  aeestudiantes_nombres varchar(64) [not null, note: 'Nombres del estudiante.']
  aeestudiantes_telefono text [note: 'Teléfono.']
  aeinstitucion_id double [not null, note: 'Institución (FK a aeinstituciones).']
  aeusu_id double [default: '700', note: 'Usuario de login asociado (FK a engine.aeusu).']
  Note: 'Estudiantes de la agenda escolar.'
}

Table data.aeestudiantes_old {
  aeacudientes_id bigint [note: 'Acudiente asociado.']
  aeano_id int [not null, note: 'Año lectivo.']
  aeestudiantes_apellidos varchar(64) [not null, note: 'Apellidos.']
  aeestudiantes_codigo varchar(32) [note: 'Código.']
  aeestudiantes_direccion text [note: 'Dirección.']
  aeestudiantes_estado int [default: '8', note: 'Estado.']
  aeestudiantes_fechanacimiento date [note: 'Fecha de nacimiento.']
  aeestudiantes_fecharegistro timestamp [not null, note: 'Fecha de registro.']
  aeestudiantes_genero char(1) [note: 'Género.']
  aeestudiantes_grupo varchar(32) [not null, note: 'Grupo/salón.']
  aeestudiantes_id int [pk, not null, note: 'Identificador del estudiante.']
  aeestudiantes_identificacion varchar(32) [note: 'Identificación.']
  aeestudiantes_mail text [note: 'Correo electrónico.']
  aeestudiantes_nombres varchar(64) [not null, note: 'Nombres.']
  aeestudiantes_telefono text [note: 'Teléfono.']
  aeinstitucion_id double [not null, note: 'Institución.']
  aeusu_id double [default: '700', note: 'Usuario de login.']
  Note: 'Copia/backup de estudiantes.'
}

Table data.aeetnias {
  aeetnias_descripcion varchar(32) [not null, note: 'Descripción de la etnia.']
  aeetnias_estado int [default: '1', note: 'Estado (1=activo).']
  aeetnias_id int [pk, not null, note: 'Identificador único de la etnia.']
  Note: 'Grupos étnicos (catálogo).'
}

Table data.aeexcusas {
  aeanol_id bigint [not null, note: 'Año lectivo.']
  aeestudiantes_id bigint [not null, note: 'Estudiante (FK a aeestudiantes).']
  aeexcusas_archivoadjunto text [note: 'Archivo adjunto (soporte).']
  aeexcusas_asignatura text [note: 'Asignaturas a las que aplica la excusa.']
  aeexcusas_desde timestamp [not null, note: 'Fecha de inicio de la inasistencia.']
  aeexcusas_estado int [default: '1', note: 'Estado de la excusa (1=activo).']
  aeexcusas_fecha timestamp [not null, default: 'CURRENT_TIMESTAMP', note: 'Fecha de registro de la excusa.']
  aeexcusas_hasta timestamp [not null, note: 'Fecha de fin de la inasistencia.']
  aeexcusas_id int [pk, not null, default: 'nextval(\'data.aeexcusas_aeexcusas_id_seq\'::regclass)', note: 'Identificador único de la excusa.']
  aeexcusas_mensaje text [not null, note: 'Mensaje/justificación de la excusa.']
  aeinst_id bigint [not null, note: 'Institución.']
  aetipoexcusa_id int [not null, note: 'Tipo de excusa (FK a aetipoexcusas).']
  Note: 'Excusas presentadas por estudiantes/acudientes por inasistencias.'
}

Table data.aeexcusas_respuestas {
  aeexcusas_id bigint [not null, note: 'Excusa (FK a aeexcusas).']
  aeexcusasrespuestas_descripcion text [note: 'Texto de la respuesta.']
  aeexcusasrespuestas_fecha timestamp [default: 'CURRENT_TIMESTAMP', note: 'Fecha de la respuesta.']
  aeexcusasrespuestas_id int [pk, not null, default: 'nextval(\'data.aeexcusas_respuestas_aeexcusasrespuestas_id_seq\'::regclass)', note: 'Identificador único de la respuesta.']
  aeexcusasrespuestas_tipo int [not null, note: 'Tipo de respuesta.']
  aeusu_id bigint [not null, note: 'Usuario que responde.']
  Note: 'Respuestas de los docentes a las excusas.'
}

Table data.aegrados {
  aegrados_codigo smallint [not null, note: 'Código del grado (ej. -1=Jardín, 11=Once).']
  aegrados_descripcion varchar(64) [note: 'Descripción del grado.']
  aegrados_estado smallint [default: '1', note: 'Estado del grado (1=activo).']
  aegrados_id smallint [pk, not null, note: 'Identificador único del grado.']
  Note: 'Grados escolares (Jardín a Once).'
}

Table data.aegruposanguineo {
  aegruposanguineo_descripcion varchar(2) [not null, note: 'Descripción del grupo (A, B, AB, O).']
  aegruposanguineo_estado int [default: '1', note: 'Estado (1=activo).']
  aegruposanguineo_id int [pk, not null, note: 'Identificador único del grupo sanguíneo.']
  Note: 'Grupos sanguíneos (catálogo).'
}

Table data.aeinstituciones {
  aeinst_direccion varchar(128) [not null, note: 'Dirección de la institución.']
  aeinst_escudo text [note: 'Ruta/imagen del escudo institucional.']
  aeinst_facebook text [note: 'URL de Facebook institucional.']
  aeinst_fax varchar(128) [note: 'Fax de la institución.']
  aeinst_himno text [note: 'Texto del himno institucional.']
  aeinst_id double [pk, not null, default: 'nextval(\'data.secuence_aeinst_id\'::regclass)', note: 'Identificador único de la institución.']
  aeinst_instagram text [note: 'URL de Instagram institucional.']
  aeinst_lema text [note: 'Lema institucional.']
  aeinst_mail varchar(128) [not null, note: 'Correo electrónico institucional.']
  aeinst_manualconvivencia text [note: 'Manual de convivencia de la institución.']
  aeinst_nit varchar(15) [not null, note: 'NIT de la institución.']
  aeinst_nombre varchar(128) [not null, note: 'Nombre de la institución.']
  aeinst_reconocimiento text [not null, note: 'Reconocimiento oficial (resolución) de la institución.']
  aeinst_resolrector text [note: 'Resolución rectoral de la institución.']
  aeinst_telefono varchar(128) [not null, note: 'Teléfono principal.']
  aeinst_telefono2 varchar(128) [note: 'Teléfono secundario.']
  aeinst_tiktok text [note: 'URL de TikTok institucional.']
  aeinst_twitter text [note: 'URL de Twitter institucional.']
  aeinst_youtube text [note: 'URL de YouTube institucional.']
  aeusu_id double [not null, note: 'Usuario administrador de la institución (FK a engine.aeusu).']
  calendario varchar(8) [note: 'Calendario de la institución (A/B).']
  codigo varchar(4) [note: 'Código corto de la institución.']
  codigo_cg1 smallint [note: 'Código interno CG1 de la institución.']
  coordx real [note: 'Coordenada X (longitud) para el mapa.']
  coordy real [note: 'Coordenada Y (latitud) para el mapa.']
  zona varchar(16) [note: 'Zona geográfica (urbana/rural).']
  Note: 'Instituciones educativas (clientes de la plataforma).'
}

Table data.aeinstituciones_ {
  aeinst_direccion varchar(128) [not null, note: 'Dirección.']
  aeinst_escudo text [not null, note: 'Escudo institucional.']
  aeinst_fax varchar(128) [note: 'Fax.']
  aeinst_himno text [note: 'Himno.']
  aeinst_id double [pk, not null, default: 'nextval(\'data.secuence_aeinst_id\'::regclass)', note: 'Identificador único de la institución.']
  aeinst_lema text [note: 'Lema.']
  aeinst_mail varchar(128) [not null, note: 'Correo electrónico.']
  aeinst_manualconvivencia text [not null, note: 'Manual de convivencia.']
  aeinst_nit varchar(15) [not null, note: 'NIT de la institución.']
  aeinst_nombre varchar(128) [not null, note: 'Nombre de la institución.']
  aeinst_reconocimiento text [not null, note: 'Reconocimiento oficial.']
  aeinst_resolrector text [note: 'Resolución rectoral.']
  aeinst_telefono varchar(128) [not null, note: 'Teléfono principal.']
  aeinst_telefono2 varchar(128) [note: 'Teléfono secundario.']
  aeusu_id double [not null, note: 'Usuario administrador de la institución.']
  Note: 'Copia/backup de instituciones educativas (tabla de respaldo).'
}

Table data.aeinstituciones_conf {
  aeinst_id double [not null, note: 'Institución (FK a aeinstituciones).']
  aeinstconf_anolectivo int [not null, note: 'Año lectivo al que aplica la configuración.']
  aeinstconf_asistencias_umbralweek int [default: '2', note: 'Umbral semanal para alertas de asistencias.']
  aeinstconf_bitacora_comunications_notifier bool [default: 'true', note: 'Permitir notificaciones de bitácora en móviles.']
  aeinstconf_bitacora_comunications_notifier_text text [default: '\'la institución habilitará los registros de observaciones próximamente\'::text', note: 'Texto cuando no pueden consultar la bitácora.']
  aeinstconf_comments_receivemail bool [default: 'true', note: 'Recibir correos cuando los móviles hacen comentarios.']
  aeinstconf_excusas_limite int [default: '1', note: 'Límite de excusas permitidas.']
  aeinstconf_id double [pk, not null, default: 'nextval(\'data.secuence_aeinstconf_id\'::regclass)', note: 'Identificador único de la configuración.']
  aeinstconf_mobile_comunications_notifier bool [default: 'true', note: 'Habilitar notificador de comunicados hacia dispositivos móviles.']
  aeinstconf_mobile_comunications_notifier_text text [default: '\'la institución habilitará los comunicados próximamente\'::text', note: 'Mensaje mostrado cuando no se pueden ver comunicados.']
  aeinstconf_mobile_query bool [default: 'true', note: 'Permitir consultas desde dispositivos móviles.']
  aeinstconf_mobile_query_text text [default: '\'la institución habilitará las consultas próximamente\'::text', note: 'Mensaje cuando no se pueden hacer consultas.']
  aeinstconf_pin_char varchar(3) [default: '\'Q\'::"char"', note: 'Letra actual con la que la institución genera el PIN.']
  aeinstconf_pin_number varchar(3) [default: '0', note: 'Número actual para generar los PINs.']
  aeinstconf_pqr_notifier bool [default: 'true', note: 'Habilitar PQRS desde dispositivos móviles.']
  aeinstconf_pqr_notifier_text text [default: '\'la institución habilitará los PQRS próximamente\'::text', note: 'Texto cuando no pueden realizar PQRS.']
  Note: 'Configuraciones (parámetros de funcionamiento) por institución y año lectivo.'
}

Table data.aeinstitucionesss {
  aeinst_direccion varchar(128) [not null, note: 'Dirección.']
  aeinst_escudo text [not null, note: 'Escudo.']
