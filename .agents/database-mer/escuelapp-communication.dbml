  aeinst_nombre varchar(128) [not null, note: 'Nombre de la institución.']
  aeinst_reconocimiento text [not null, note: 'Reconocimiento oficial.']
  aeinst_resolrector text [note: 'Resolución rectoral.']
  aeinst_telefono varchar(128) [not null, note: 'Teléfono principal.']
  aeinst_telefono2 varchar(128) [note: 'Teléfono secundario.']
  aeusu_id double [not null, note: 'Usuario administrador.']
  Note: 'Copia/backup adicional de instituciones educativas.'
}

Table data.aejornada {
  aejornada_descripcion varchar(32) [not null, note: 'Descripción de la jornada.']
  aejornada_estado int [default: '1', note: 'Estado de la jornada (1=activo).']
  aejornada_id int [pk, not null, note: 'Identificador único de la jornada.']
  Note: 'Jornadas escolares (diurna, nocturna, mañana, tarde, única).'
}

Table data.aelog_envios {
  aeestudiantes_id bigint [not null, note: 'Estudiante relacionado.']
  destino varchar(20) [not null, note: 'Número de destino.']
  emisor varchar(14) [not null, note: 'Número emisor de WhatsApp.']
  enviosdetalles text [note: 'Detalles del envío.']
  fecharegistro timestamp [not null, default: 'CURRENT_TIMESTAMP', note: 'Fecha del envío.']
  idempresa bigint [not null, note: 'Institución (FK a aeinstituciones).']
  idlogenvios int [pk, not null, default: 'nextval(\'data.aelog_envios_idlogenvios_seq\'::regclass)', note: 'Identificador único del envío.']
  idreferencia bigint [not null, note: 'Referencia del registro que motivó el envío.']
  sent bool [not null, default: 'false', note: 'Si fue enviado.']
  tipo int [not null, note: 'Tipo de mensaje (FK a aetipo_envio).']
  Note: 'Log de envíos de mensajes (WhatsApp) realizados.'
}

Table data.aelogdispositivos {
  aelogdispositivos_fecha timestamp [not null, note: 'Fecha del acceso.']
