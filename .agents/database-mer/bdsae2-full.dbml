  canolid int [not null, note: 'Año lectivo (FK a tabanol).']
  cinstid int [not null, note: 'Institución (FK a tabinst).']
  clibsie bit(1) [note: 'Indicador de libre/autonomía.']
  csieesta int [not null, default: '8', note: 'Estado (8=activo).']
  csieid int [pk, not null, note: 'Identificador único del registro.']
  ctipodeseid int [not null, note: 'Tipo de desempeño (FK a tabtipodese).']
  cvalprosie double [not null, note: 'Valor de promoción.']
  Note: 'SIE (Sistema Institucional de Evaluación): valor de promoción por institución y año.'
}

Table public.tabsisb {
  csisbdesc text [note: 'Descripción del nivel SISBEN.']
  csisbesta int [note: 'Estado.']
  csisbid int [pk, not null, note: 'Identificador único del nivel.']
  Note: 'Niveles SISBEN (catálogo).'
}

Table public.tabsucu {
  csucuclas char(1) [note: 'Clase de sucursal.']
  csucucodi int [note: 'Código de la sucursal (único).']
  csucudesc text [not null, note: 'Descripción de la ubicación.']
  csucudire text [note: 'Dirección.']
  csucuidpunt int [pk, not null, note: 'Identificador único del punto.']
  csuculati double [not null, note: 'Latitud.']
  csuculong double [not null, note: 'Longitud.']
  Note: 'Ubicación de las escuelas en el mapa web (sucursales).'
}

Table public.tabtipodese {
  cdesctipodese text [not null, note: 'Descripción del tipo de desempeño.']
  cestatipdese int [not null, default: '8', note: 'Estado (8=activo).']
  ctipodeseid int [pk, not null, note: 'Identificador único del tipo de desempeño.']
  Note: 'Tipos de desempeño (cognitivo, personal, social, etc.) (catálogo).'
}

Table public.tabtipodocu {
  ctipodocudesc text [note: 'Descripción del tipo de documento.']
  ctipodocuesta int [note: 'Estado.']
  ctipodocuid int [pk, not null, note: 'Identificador único del tipo de documento.']
  Note: 'Tipos de documento oficiales en Colombia (catálogo).'
}

Table public.tabtiponota {
  ctiponotadesc text [note: 'Descripción del tipo de nota.']
  ctiponotaesta int [note: 'Estado.']
  ctiponotaid int [pk, not null, note: 'Identificador único del tipo de nota.']
  Note: 'Tipos de nota para la calificación de indicadores de logros (catálogo).'
}

Table public.tabtiponove {
  ctiponoveabre varchar(2) [note: 'Abreviatura del tipo de novedad.']
  ctiponovedesc text [note: 'Descripción del tipo de novedad.']
  ctiponoveesta int [note: 'Estado.']
  ctiponoveid int [pk, not null, note: 'Identificador único del tipo de novedad.']
  Note: 'Tipos de novedad: inasistencia, observación, etc. (catálogo).'
}

Table public.tabtiposang {
  ctiposangdesc varchar(20) [note: 'Descripción del tipo de sangre.']
  ctiposangesta int [note: 'Estado.']
  ctiposangid int [pk, not null, note: 'Identificador único del tipo de sangre.']
  Note: 'Tipos de sangre conocidos (catálogo).'
}

Table public.tabtiposubs {
  ctiposubsdesc text [note: 'Descripción del subsidio.']
  ctiposubsesta int [note: 'Estado.']
  ctiposubsid int [pk, not null, note: 'Identificador único del subsidio.']
  Note: 'Tipos de subsidio (catálogo).'
}

Table public.tabtipovinc {
  ctipovincdesc text [note: 'Descripción del tipo de vinculación.']
  ctipovincesta int [note: 'Estado.']
  ctipovincid int [pk, not null, note: 'Identificador único del tipo de vinculación.']
  Note: 'Tipos de vinculación en los contratos de los empleados (catálogo).'
}

Table public.tabunio {
  cacadid int [not null, note: 'Usuario académico (estudiante/docente) asociado.']
  cunioesta int [not null, note: 'Estado del enlace.']
  cunioid int [pk, not null, note: 'Identificador único del enlace.']
  cusuaid int [not null, note: 'Usuario de login (FK a logic.tabusua).']
  indexes {
    (cusuaid, cacadid, cunioesta) [unique]
  }
  Note: 'Unión de los usuarios de login con los usuarios académicos (enlace entre esquemas).'
}

Table public.tabutil {
  ccursid int [not null, note: 'Curso (FK a tabcurs).']
  cutilcant int [note: 'Cantidad del útil.']
  cutildesc text [note: 'Descripción del útil.']
  cutilid int [pk, not null, note: 'Identificador único del útil.']
  Note: 'Útiles escolares requeridos para los cursos.'
}

Table public.tabzonaresi {
  czonaresidesc text [not null, note: 'Descripción de la zona.']
  czonaresiesta int [note: 'Estado.']
  czonaresiid int [pk, not null, note: 'Identificador único de la zona.']
  Note: 'Zona de residencia oficial (catálogo).'
}

Table public.tipo_citacion {
  motivo_estado smallint [not null, note: 'Estado del motivo.']
  motivo_id int [pk, not null, note: 'Identificador único del motivo.']
  motivo_nombre varchar(200) [not null, note: 'Nombre del motivo.']
  Note: 'Tipos/motivos de citación (catálogo del SAE).'
}

