Table varios.estuasesoria {
  estaases int [note: 'Estado del registro.']
  idases int [pk, not null, note: 'Identificador único del registro.']
  nomases varchar(50) [note: 'Nombre del estudiante en asesoría.']
  Note: 'Estudiantes en asesoría (tarea específica de una institución).'
}

Table varios.sorteo {
  estasorteo int [note: 'Estado del sorteo.']
  fechsorteo date [note: 'Fecha del sorteo.']
  idsorteo int [pk, not null, note: 'Identificador único del sorteo.']
  nomsorteo varchar(50) [note: 'Nombre del sorteo.']
  Note: 'Sorteos (tarea específica).'
}

