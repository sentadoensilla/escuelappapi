  aeacudientes_telresidencia varchar(255) [note: 'Teléfono de residencia.']
  aeacudientes_tipoidentificacion smallint [not null, note: 'Tipo de identificación.']
  aeusu_id int [not null, note: 'Usuario de login.']
  Note: 'Matrícula: datos de los acudientes en el proceso de matrícula.'
}

Table data.aematriculas_adjuntos {
