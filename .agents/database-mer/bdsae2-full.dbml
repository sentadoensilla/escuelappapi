  aeestudiantesdemografia_discapacidad int [note: 'Discapacidad (FK a aediscapacidades).']
  aeestudiantesdemografia_discapacidad_otra varchar(32) [note: 'Otra discapacidad.']
  aeestudiantesdemografia_eps int [not null, note: 'EPS (FK a aeeps).']
  aeestudiantesdemografia_estrato int [note: 'Estrato socioeconómico.']
  aeestudiantesdemografia_etnia smallint [default: '0', note: 'Etnia (FK a aeetnias).']
  aeestudiantesdemografia_fecharegistro timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  aeestudiantesdemografia_gruposanguineo int [note: 'Grupo sanguíneo (FK a aegruposanguineo).']
  aeestudiantesdemografia_id int [pk, not null, default: 'nextval(\'data.aematriculas_demografia_aeestudiantesdemografia_id_seq\'::regclass)', note: 'Identificador único del registro.']
  aeestudiantesdemografia_mupionacimiento int [note: 'Municipio de nacimiento.']
  aeestudiantesdemografia_paisnacimiento int [note: 'País de nacimiento.']
  aeestudiantesdemografia_peso numeric [note: 'Peso.']
  aeestudiantesdemografia_rh char(1) [note: 'Factor RH.']
  aeestudiantesdemografia_sisben bool [default: 'true', note: 'Si tiene SISBEN.']
  aeestudiantesdemografia_sisbennivel numeric [not null, note: 'Nivel SISBEN.']
  aeestudiantesdemografia_talla text [note: 'Talla.']
  aeestudiantesdemografia_tratamientoterapia bool [note: 'Si está en tratamiento/terapia.']
  aeestudiantesdemografia_tratamientoterapia_cual varchar(255) [note: 'Detalle del tratamiento.']
  Note: 'Matrícula: datos demográficos y de salud del estudiante.'
}

Table data.aematriculas_estudiantes {
  aeacudientes_id bigint [note: 'Acudiente asociado.']
  aeano_id int [not null, note: 'Año lectivo.']
  aeestudiantes_apellidos varchar(64) [not null, note: 'Apellidos del estudiante.']
  aeestudiantes_codigo varchar(32) [note: 'Código.']
  aeestudiantes_direccion text [note: 'Dirección.']
  aeestudiantes_estado smallint [note: 'Estado de la matrícula.']
  aeestudiantes_fechanacimiento date [note: 'Fecha de nacimiento.']
  aeestudiantes_fecharegistro timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  aeestudiantes_genero char(1) [note: 'Género.']
  aeestudiantes_grado smallint [note: 'Grado (FK a aegrados).']
  aeestudiantes_grupo varchar(32) [note: 'Grupo/salón.']
  aeestudiantes_id int [pk, not null, default: 'nextval(\'data.aematriculas_estudiantes_aeestudiantes_id_seq\'::regclass)', note: 'Identificador único del estudiante (FK a aeestudiantes).']
  aeestudiantes_identificacion varchar(32) [note: 'Identificación.']
  aeestudiantes_jornada smallint [note: 'Jornada (FK a aejornada).']
  aeestudiantes_mail text [note: 'Correo.']
  aeestudiantes_nombres varchar(64) [not null, note: 'Nombres del estudiante.']
  aeestudiantes_telefono text [note: 'Teléfono.']
  aeestudiantes_tipodocumento smallint [default: '2', note: 'Tipo de documento (FK a aetipodocumento).']
  aeinstitucion_id int [not null, note: 'Institución.']
  aeusu_id int [note: 'Usuario que registra.']
  Note: 'Matrícula: datos del estudiante en el proceso de matrícula.'
}

Table data.aemediciones {
  aelogdispositivos_model text [note: 'Modelo del dispositivo.']
  aelogdispositivos_platform text [note: 'Plataforma.']
  aelogdispositivos_serial text [note: 'Serial.']
  aelogdispositivos_source text [note: 'Origen del registro.']
  aelogdispositivos_uuid text [note: 'UUID.']
  aelogdispositivos_version text [note: 'Versión.']
  aemediciones_concepto text [not null, note: 'Concepto evaluado.']
  aemediciones_estudiante double [not null, note: 'Estudiante evaluado.']
  aemediciones_fecha timestamp [not null, note: 'Fecha de la medición.']
  aemediciones_grupo varchar(32) [note: 'Grupo/salón.']
  aemediciones_id double [pk, not null, note: 'Identificador único de la medición.']
  aemediciones_valor double [not null, note: 'Valor de la medición.']
  aeusu_id text [not null, note: 'Usuarios destinatarios.']
  Note: 'Mediciones/valoraciones (conceptos evaluados) de los estudiantes.'
}

Table data.aemotivo {
  aeestados_id int [not null, note: 'Estado asociado (FK a aeestados).']
  aemotivo_id int [pk, not null, note: 'Identificador único del motivo.']
  aemotivo_nombre varchar [not null, note: 'Nombre del motivo (Agresión, Evasión, etc.).']
  Note: 'Motivos de citación (catálogo).'
}

Table data.aenotificaciones {
  aenotificaciones_body text [note: 'Cuerpo de la notificación.']
  aenotificaciones_data text [not null, note: 'Datos adicionales.']
  aenotificaciones_de double [not null, note: 'Usuario remitente.']
  aenotificaciones_estado int [default: '11', note: 'Estado de la notificación (FK a aeestados).']
  aenotificaciones_fecha timestamp [not null, note: 'Fecha de la notificación.']
  aenotificaciones_id double [pk, not null, note: 'Identificador único de la notificación.']
  aenotificaciones_para text [not null, note: 'Usuarios destinatarios.']
  aenotificaciones_referencia double [not null, note: 'Referencia al registro origen.']
  aenotificaciones_ruta text [note: 'Ruta/URL de destino al abrir.']
  aenotificaciones_title text [note: 'Título de la notificación.']
  Note: 'Notificaciones internas generadas para los usuarios (inbox).'
}

Table data.aeopcres {
  aeopcres_descripcion text [not null, note: 'Texto de la opción.']
  aeopcres_estado bool [default: 'true', note: 'Estado (true=activo).']
  aeopcres_id int [pk, not null, default: 'nextval(\'data.aeopcres_aeopcres_id_seq\'::regclass)', note: 'Identificador único de la opción.']
  aeopcres_orden int [note: 'Orden de la opción.']
  aeopcres_valor double [note: 'Valor/puntaje de la opción.']
  aepre_id bigint [not null, note: 'Pregunta a la que pertenece (FK a aepre).']
  Note: 'Opciones de respuesta para las preguntas de un cuestionario.'
}

Table data.aepqr {
  aeano_id int [note: 'Año lectivo.']
  aeestados_id int [note: 'Estado del PQRS (FK a aeestados).']
  aeinst_id int [not null, note: 'Institución (FK a aeinstituciones).']
  aepqr_adjunto varchar(500) [note: 'Archivo adjunto.']
  aepqr_contenido text [not null, note: 'Contenido del PQRS.']
  aepqr_email varchar(64) [not null, note: 'Correo del solicitante.']
  aepqr_fecha timestamp(6) without time zone [not null, note: 'Fecha del PQRS.']
  aepqr_id int [pk, not null, note: 'Identificador único del PQRS.']
  aepqr_nombre text [not null, note: 'Nombre del solicitante.']
  aepqr_telefono varchar(13) [note: 'Teléfono del solicitante.']
  aepqr_tiposolicitud_id int [not null, note: 'Tipo de solicitud (FK a aepqr_tiposolicitud).']
  aepqr_usuario int [not null, note: 'Usuario que registra (FK a engine.aeusu).']
  Note: 'PQRS (peticiones, quejas, reclamos y sugerencias/felicitaciones) de los usuarios.'
}

Table data.aepqr_respuesta {
  aepqr_id int [note: 'PQRS respondido (FK a aepqr, único).']
  aepqr_respuesta_adjunto varchar(128) [note: 'Archivo adjunto.']
  aepqr_respuesta_fecha timestamp(6) without time zone [note: 'Fecha de la respuesta.']
  aepqr_respuesta_id int [not null, note: 'Identificador único de la respuesta.']
  aepqr_respuesta_mensaje text [note: 'Texto de la respuesta.']
  Note: 'Respuestas a los PQRS.'
}

Table data.aepqr_tiposolicitud {
  aepqr_tiposolicitud_descripcion varchar(16) [note: 'Descripción del tipo de solicitud.']
  aepqr_tiposolicitud_id int [pk, not null, default: 'nextval(\'data.aepqr_tiposolicitud_aepqr_tiposolicitud_id_seq\'::regclass)', note: 'Identificador único del tipo de solicitud.']
  aepqr_tiposolicitud_vencimiento int [note: 'Días para el vencimiento de la respuesta.']
  Note: 'Tipos de solicitud PQRS (Petición, Quejas, Reclamos, Felicitaciones).'
}

Table data.aepre {
  aecue_id bigint [not null, note: 'Evaluación a la que pertenece (FK a aecue).']
  aepre_descripcion text [not null, note: 'Enunciado de la pregunta.']
  aepre_estado bool [default: 'true', note: 'Estado (true=activo).']
  aepre_fechacreacion timestamp [note: 'Fecha de creación.']
  aepre_id bigint [pk, not null, default: 'nextval(\'data.aepre_aecue_id_seq\'::regclass)', note: 'Identificador único de la pregunta.']
  aepre_orden int [default: '1', note: 'Orden de la pregunta.']
  aetippre_id int [not null, note: 'Tipo de pregunta (FK a aetippre).']
  Note: 'Preguntas de un cuestionario/evaluación.'
}

Table data.aepublicaciones {
  aeanol_id bigint [not null, note: 'Año lectivo.']
  aeinst_id text [not null, note: 'Instituciones a las que aplica.']
  aepublicaciones_aceptarespuestas bool [default: 'true', note: 'Si acepta respuestas.']
  aepublicaciones_adjunto text [note: 'Archivo adjunto.']
  aepublicaciones_alcance int [default: '1', note: 'Alcance de la publicación.']
  aepublicaciones_descripcion text [not null, note: 'Descripción.']
  aepublicaciones_estado int [default: '1', note: 'Estado (1=activo).']
  aepublicaciones_estudiantesid text [note: 'Estudiantes específicos.']
  aepublicaciones_fecha timestamp [not null, note: 'Fecha de creación.']
  aepublicaciones_fechafinalizacion timestamp [not null, note: 'Fecha de finalización.']
  aepublicaciones_fechapublicacion timestamp [not null, note: 'Fecha de publicación.']
  aepublicaciones_grupo varchar[] [note: 'Grupos a los que aplica.']
  aepublicaciones_id bigint [pk, not null, note: 'Identificador único de la publicación.']
  aepublicaciones_titulo text [not null, note: 'Título.']
  aepublicacionestipo_id int [default: '0', note: 'Tipo de publicación (FK a aepublicaciones_tipo).']
  aeusu_id bigint [not null, note: 'Usuario autor.']
  Note: 'Publicaciones generales (noticias, anuncios) de la institución.'
}

Table data.aepublicaciones_alerta {
  aepublicaciones_id bigint [not null, note: 'Publicación (FK a aepublicaciones).']
  aepublicacionesalerta_fecha timestamp [not null, default: 'CURRENT_TIMESTAMP', note: 'Fecha de la alerta.']
  aepublicacionesalerta_id int [not null, default: 'nextval(\'data.aepublicaciones_alerta_aepublicacionesalerta_id_seq\'::regclass)', note: 'Identificador único de la alerta.']
  Note: 'Alertas/recordatorios de publicaciones.'
}

Table data.aepublicaciones_comentarios {
  aepublicaciones_id bigint [not null, note: 'Publicación (FK a aepublicaciones).']
  aepublicacionescomentarios_descripcion text [not null, note: 'Texto del comentario.']
  aepublicacionescomentarios_estado int [default: '1', note: 'Estado (1=activo).']
  aepublicacionescomentarios_fecha timestamp [not null, note: 'Fecha del comentario.']
  aepublicacionescomentarios_id bigint [pk, not null, note: 'Identificador único del comentario.']
  aeusu_id bigint [not null, note: 'Usuario que comenta.']
  Note: 'Comentarios a las publicaciones.'
}

Table data.aepublicaciones_tipo {
  aepublicacionestipo_color varchar(8) [default: '\'#FBB919\'::character varying', note: 'Color asociado al tipo.']
  aepublicacionestipo_descripcion text [not null, note: 'Descripción del tipo.']
  aepublicacionestipo_estado int [not null, default: '1', note: 'Estado (1=activo).']
  aepublicacionestipo_id int [not null, default: 'nextval(\'data.aepublicaciones_tipo_aepublicacionestipo_id_seq\'::regclass)', note: 'Identificador único del tipo.']
  Note: 'Tipos de publicación (catálogo con color).'
}

Table data.aeres {
  aeopcres_id int [note: 'Opción elegida (FK a aeopcres).']
  aepre_id bigint [not null, note: 'Pregunta respondida (FK a aepre).']
  aeres_id bigint [not null, note: 'Identificador único de la respuesta.']
  aeresp_abierta text [note: 'Respuesta abierta (texto libre).']
  inst_cue_res_id bigint [not null, note: 'Intento (FK a inst_cue_res).']
  Note: 'Respuestas dadas a las preguntas de un cuestionario en un intento.'
}

Table data.aesolicitud {
  aeanol_id int [not null, note: 'Año lectivo.']
  aeinst_id int [not null, note: 'Institución (FK a aeinstituciones).']
  aesolicitud_destino varchar(128) [default: '\'Reclamar en secretaría del colegio\'::character varying', note: 'Destino/forma de entrega del certificado.']
  aesolicitud_estado int [default: '1', note: 'Estado de la solicitud.']
  aesolicitud_fecha date [default: '(\'now\'::text)::date', note: 'Fecha de la solicitud.']
  aesolicitud_hora time [default: '(\'now\'::text)::time without time zone', note: 'Hora de la solicitud.']
  aesolicitud_id double [pk, not null, note: 'Identificador único de la solicitud.']
  aesolicitud_mensaje text [not null, note: 'Mensaje de la solicitud.']
  aetipo_certicado int [not null, note: 'Tipo de certificado (FK a aetipo_certificado).']
  aeusu_id int [not null, note: 'Usuario que solicita.']
  Note: 'Solicitudes de certificados (paz y salvo, notas, matrícula, etc.).'
}

Table data.aetar {
  aetar_adjunto1 varchar(256) [note: 'Adjunto 1.']
  aetar_adjunto2 varchar(256) [note: 'Adjunto 2.']
  aetar_adjunto3 varchar(256) [note: 'Adjunto 3.']
  aetar_descripcion text [not null, note: 'Descripción de la tarea.']
  aetar_estado int [default: '1', note: 'Estado (1=activo).']
  aetar_fechacreacion timestamp [not null, note: 'Fecha de creación.']
  aetar_id bigint [not null, note: 'Identificador único de la tarea.']
  aetar_nombre varchar(128) [not null, note: 'Nombre de la tarea.']
  Note: 'Tareas (plantillas de homework).'
}

Table data.aetar_pro {
  aeanol_id bigint [not null, note: 'Año lectivo.']
  aeasignaciones_asignatura varchar(64) [not null, note: 'Asignatura.']
  aedocentes_id bigint [not null, note: 'Docente que asigna.']
  aeestudiantes_grupo varchar(32) [not null, note: 'Grupo/salón.']
  aeinst_id bigint [not null, note: 'Institución.']
  aetar_id bigint [not null, note: 'Tarea (FK a aetar).']
  aetar_pro_estado int [default: '1', note: 'Estado (1=activo).']
  aetar_pro_fechalimite timestamp [not null, note: 'Fecha límite de entrega.']
  aetar_pro_id bigint [not null, note: 'Identificador único de la programación.']
  Note: 'Programación de tareas (asignación de una tarea a un grupo/institución/año).'
}

Table data.aetar_res {
  aeestudiantes_id bigint [not null, note: 'Estudiante que entrega.']
  aetar_pro_id bigint [not null, note: 'Programación (FK a aetar_pro).']
  aetar_res_adjunto1 varchar(256) [note: 'Adjunto 1.']
  aetar_res_adjunto2 varchar(256) [note: 'Adjunto 2.']
  aetar_res_adjunto3 varchar(256) [note: 'Adjunto 3.']
  aetar_res_aprobacion bool [default: 'false', note: 'Si fue aprobada.']
  aetar_res_descripcion text [not null, note: 'Descripción de la entrega.']
  aetar_res_estado int [default: '1', note: 'Estado (1=activo).']
  aetar_res_fechaentrega timestamp [not null, note: 'Fecha de entrega.']
  aetar_res_id bigint [not null, note: 'Identificador único de la entrega.']
  aetar_res_resultado double [note: 'Resultado/calificación.']
  Note: 'Entrega de tareas (respuesta del estudiante a una tarea programada).'
}

Table data.aetipint {
  aetipint_descripcion varchar(64) [note: 'Descripción del tipo de intento.']
  aetipint_estado bool [default: 'true', note: 'Estado (true=activo).']
  aetipint_id int [pk, not null, note: 'Identificador único del tipo de intento.']
  Note: 'Tipos de intento para calificar un cuestionario (promedio, primer intento, último intento).'
}

Table data.aetipo_certificado {
  aeestado_id int [note: 'Estado (FK a aeestados).']
  aetipocertificado_descripcion varchar [note: 'Descripción del certificado.']
  aetipocertificado_id bigint [pk, not null, note: 'Identificador único del tipo de certificado.']
  aetipocertificado_nombre varchar [note: 'Nombre del certificado.']
  Note: 'Tipos de certificado (paz y salvo, estudio, matrícula, notas, conducta, etc.).'
}

Table data.aetipo_envio {
  aeestado_id int [default: '1', note: 'Estado (FK a aeestados).']
  aetipoenvio_descripcion varchar(64) [note: 'Descripción del tipo de envío.']
  aetipoenvio_id bigint [pk, not null, note: 'Identificador único del tipo de envío.']
  Note: 'Tipos de envío de notificaciones (comunicado, asistencia, horario, excusa, tarea, etc.).'
}

Table data.aetipodocumento {
  aetipodocumento_descripcion varchar(64) [note: 'Descripción del tipo de documento.']
  aetipodocumento_estado smallint [default: '1', note: 'Estado (1=activo).']
  aetipodocumento_id smallint [not null, note: 'Identificador único del tipo de documento.']
  aetipodocumento_sigla varchar(8) [not null, note: 'Sigla del tipo de documento (C.C., T.I., etc.).']
  Note: 'Tipos de documento de identidad (catálogo).'
}

Table data.aetipoempresa {
  aetipoempresa_descripcion varchar(32) [note: 'Descripción del tipo de empresa.']
  aetipoempresa_estado smallint [default: '1', note: 'Estado (1=activo).']
  aetipoempresa_id smallint [pk, not null, note: 'Identificador único del tipo de empresa.']
  Note: 'Tipos de empresa del acudiente (catálogo de encuesta).'
}

Table data.aetipoexcusas {
  aetipoexcusa_descripcion text [not null, note: 'Descripción del tipo de excusa.']
  aetipoexcusa_id int [pk, not null, note: 'Identificador único del tipo de excusa.']
  aetipoexcusa_nombre text [not null, note: 'Nombre del tipo de excusa.']
  aetipoexcusas_estado int [not null, note: 'Estado del tipo de excusa.']
  Note: 'Tipos de excusa (catálogo: salud, calamidad, etc.).'
}

Table data.aetippre {
  aetippre_descripcion varchar(64) [note: 'Descripción del tipo de pregunta.']
  aetippre_estado bool [default: 'true', note: 'Estado (true=activo).']
  aetippre_id int [pk, not null, default: 'nextval(\'data.aetippre_aetippre_id_seq\'::regclass)', note: 'Identificador único del tipo de pregunta.']
  Note: 'Tipos de pregunta de los cuestionarios (única, múltiple, abierta, verdadero/falso, etc.).'
}

Table data.inst_cue {
  aeano_id int [not null, note: 'Año lectivo.']
  aecue_id bigint [not null, note: 'Cuestionario (FK a aecue).']
  aeestudiantes_grupo varchar(32) [not null, note: 'Grupo/salón habilitado.']
  aeinst_cue_duracion interval [default: '\'00:30:00\'::time without time zone', note: 'Duración permitida del cuestionario.']
  aeinst_cue_estado int [default: '1', note: 'Estado (1=activo).']
  aeinst_cue_fechacreacion timestamp [not null, note: 'Fecha de creación.']
  aeinst_cue_fechafin timestamp [not null, note: 'Fecha de fin de la habilitación.']
  aeinst_cue_fechaini timestamp [not null, note: 'Fecha de inicio de la habilitación.']
  aeinst_cue_id bigint [pk, not null, note: 'Identificador único de la habilitación.']
  aeinst_cue_intentos int [default: '1', note: 'Número de intentos permitidos.']
  aeinst_cue_ordenado bool [default: 'true', note: 'Si las preguntas van en orden.']
  aeinst_cue_resultadominimo double [note: 'Resultado mínimo para aprobar.']
  aeinst_cue_tipointento int [note: 'Tipo de intento a calificar (FK a aetipint).']
  aeinst_id double [not null, note: 'Institución (FK a aeinstituciones).']
  aeusu_id bigint [not null, note: 'Docente que habilita (FK a engine.aeusu).']
  Note: 'Cuestionarios habilitados para un salón/grupo de una institución.'
}

Table data.inst_cue_res {
  aeinst_cue_id bigint [not null, note: 'Cuestionario habilitado (FK a inst_cue).']
  aeusu_id double [not null, note: 'Usuario/estudiante que responde.']
  inst_cue_res_aprobacion bool [default: 'false', note: 'Si aprobó.']
  inst_cue_res_duracion interval [note: 'Duración del intento.']
  inst_cue_res_estado int [default: '1', note: 'Estado (1=activo).']
  inst_cue_res_fechafin timestamptz [not null, note: 'Fecha de fin del intento.']
  inst_cue_res_fechaini timestamptz [not null, note: 'Fecha de inicio del intento.']
  inst_cue_res_fechaintento timestamptz [not null, note: 'Fecha del intento.']
  inst_cue_res_id bigint [pk, not null, note: 'Identificador único del intento.']
  inst_cue_res_resultado double [not null, note: 'Resultado obtenido.']
  Note: 'Intentos de respuesta de un estudiante a un cuestionario habilitado.'
}

Table data.inst_doce {
  aeanol_id int [note: 'Año lectivo de la relación.']
  aedocentes_id double [not null, note: 'Docente (FK a aedocentes).']
  aeinst_id double [not null, note: 'Institución (FK a aeinstituciones).']
  inst_doce_estado int [default: '1', note: 'Estado de la relación (1=activo).']
  inst_doce_id double [pk, not null, default: 'nextval(\'data.secuence_inst_doce_id\'::regclass)', note: 'Identificador único de la relación.']
  Note: 'Relación entre instituciones y docentes (docente contratado en una institución y año).'
}

Table data.tipo_citacion {
  motivo_estado smallint [not null, note: 'Estado del motivo.']
  motivo_id int [pk, not null, note: 'Identificador único del motivo.']
  motivo_nombre varchar(200) [not null, note: 'Nombre del motivo.']
  Note: 'Tipos/motivos de citación (catálogo adicional).'
}

Table engine.aemenu {
  aemenu_descripcion text [not null, note: 'Descripción del menú.']
  aemenu_estado int [not null, note: 'Estado del menú.']
  aemenu_icono text [not null, note: 'Icono del menú.']
  aemenu_id int [pk, not null, note: 'Identificador único del menú.']
  aemenu_nombre text [not null, note: 'Nombre del menú.']
  aemenu_orden int [note: 'Orden de visualización del menú.']
  Note: 'Menús (agrupadores de opciones) de la agenda escolar.'
}

Table engine.aeopcmenu {
  aemenu_id int [not null, note: 'Menú padre de la opción (FK a aemenu).']
  aeopcmenu_descripcion text [not null, note: 'Descripción de la opción.']
  aeopcmenu_enlace text [not null, note: 'Enlace/ruta de la opción.']
  aeopcmenu_estado int [not null, note: 'Estado de la opción (1=activo).']
  aeopcmenu_icono text [not null, note: 'Icono de la opción.']
  aeopcmenu_id int [pk, not null, note: 'Identificador único de la opción.']
  aeopcmenu_nombre text [not null, note: 'Nombre de la opción de menú.']
  aeopcmenu_orden int [not null, note: 'Orden de visualización de la opción.']
  Note: 'Opciones de menú (páginas/acciones) dentro de cada menú.'
}

Table engine.aeroll {
  aeroll_descripcion text [not null, note: 'Descripción del rol.']
  aeroll_esta int [not null, note: 'Estado del rol.']
  aeroll_id int [pk, not null, note: 'Identificador único del rol.']
  aeroll_index text [not null, note: 'Página de inicio a la que redirige el rol.']
  aeroll_nombre varchar(20) [not null, note: 'Nombre del rol.']
  Note: 'Roles de la agenda escolar (admin académico, docente, estudiante, acudiente, etc.).'
}

Table engine.aerollopc {
  aeopcmenu_id int [not null, note: 'Opción de menú (FK a aeopcmenu).']
  aeroll_id int [not null, note: 'Rol al que se asigna la opción (FK a aeroll).']
  aerollopc_estado int [default: '1', note: 'Estado del privilegio (1=activo).']
  aerollopc_id int [pk, not null, note: 'Identificador único del privilegio.']
  indexes {
    (aerollopc_estado, aeopcmenu_id, aeroll_id) [unique]
  }
  Note: 'Privilegios por rol: opciones de menú a las que puede acceder cada rol.'
}

Table engine.aeusu {
  aeroll_id int [not null, note: 'Rol del usuario (FK a aeroll).']
  aeusu_estado int [not null, note: 'Estado del usuario.']
  aeusu_id double [pk, not null, default: 'nextval(\'engine.secuence_aeusu_id\'::regclass)', note: 'Identificador único del usuario.']
  aeusu_llave text [not null, note: 'Clave/password del usuario.']
  aeusu_nick text [not null, note: 'Nick/usuario de login (único).']
  aeusu_nombre text [not null, note: 'Nombre del usuario.']
  aeusu_token text [note: 'Token de sesión/dispositivo del usuario.']
  Note: 'Usuarios de la agenda escolar (login).'
}

Table engine.aeusuopc {
  aeopcmenu_id int [not null, note: 'Opción de menú (FK a aeopcmenu).']
  aeusu_id int [not null, note: 'Usuario (FK a aeusu).']
  aeusuopc_estado int [default: '1', note: 'Estado del privilegio (1=activo).']
  aeusuopc_id int [pk, not null, note: 'Identificador único del privilegio.']
  indexes {
    (aeopcmenu_id, aeusu_id, aeusuopc_estado) [unique]
  }
  Note: 'Privilegios por usuario: opciones de menú adicionales asignadas a un usuario específico.'
}

Table engine.aeusuresetpass {
  aeusu_id double [not null, note: 'Usuario que solicita el cambio (FK a aeusu).']
  aeusures_dirip varchar(32) [note: 'IP desde donde se generó la solicitud.']
  aeusures_estado int [default: '8', note: 'Estado de la solicitud.']
  aeusures_fechageneracion timestamp [not null, note: 'Fecha de generación de la solicitud.']
  aeusures_fechalink timestamp [note: 'Fecha en que se usó el enlace.']
  aeusures_fechavence timestamp [not null, note: 'Fecha de vencimiento del enlace.']
  aeusures_id int [pk, not null, note: 'Identificador único de la solicitud.']
  aeusures_llavenew text [note: 'Nueva clave propuesta.']
  aeusures_llavepre text [not null, note: 'Clave anterior (verificación).']
  Note: 'Solicitudes de restablecimiento de contraseña de los usuarios.'
}

Table engine.aeusuroll {
  aeacad_referencia bigint [note: 'Referencia académica asociada (docente, estudiante o acudiente).']
  aeanol_id int [note: 'Año lectivo en el que aplica el rol.']
  aeinst_id int [note: 'Institución en la que aplica el rol.']
  aeroll_id int [not null, note: 'Rol asignado (FK a aeroll).']
  aeusu_id bigint [not null, note: 'Usuario (FK a aeusu).']
  aeusuroll_estado int [default: '1', note: 'Estado de la relación (1=activo).']
  aeusuroll_fecharegistro timestamptz [default: 'CURRENT_TIMESTAMP', note: 'Fecha de registro de la relación.']
  aeusuroll_id int [pk, not null, default: 'nextval(\'engine.secuence_aeusuroll_id\'::regclass)', note: 'Identificador único del registro.']
  Note: 'Relación usuario-rol con alcance por institución y año lectivo (un usuario puede tener varios roles/contextos).'
}

Table estadistica.tabhistvis {
  chisesta int [not null, default: '8', note: 'Estado del registro (8=activo).']
  chistfech timestamp(6) without time zone [not null, note: 'Fecha y hora de la visita.']
  chistid int [pk, not null, note: 'Identificador único de la visita.']
  chistpage varchar(200) [not null, note: 'Página visitada (URL/ruta).']
  cusuaid int [not null, note: 'Identificador del usuario que visitó la página.']
  cusuatip varchar(20) [note: 'Tipo de usuario que realizó la visita.']
  Note: 'Historial de visitas: páginas consultadas por cada usuario en la aplicación.'
}

Table integration.tabenla {
  cenladesc text [not null, note: 'Descripción/tabla de destino del enlace.']
  cenladesccamp text [not null, note: 'Campo(s) de la tabla de destino usados en el enlace.']
  cenladescextr text [not null, note: 'Campos adicionales (extra) para la visualización en el enlace.']
  cenlaesta int [not null, note: 'Estado del enlace.']
  cenlaid int [pk, not null, note: 'Identificador único del enlace.']
  Note: 'Mapeo de enlace entre los esquemas SAE (public/logic) y la agenda (Escuelapp): describe los campos con los que se hace el enlace.'
}

Table integration.tabregiacti {
  cregiactifech date [not null, note: 'Fecha de la actividad.']
  cregiactihora time [not null, note: 'Hora de la actividad.']
  cregiactiid real [pk, not null, note: 'Identificador único del registro de actividad.']
  cregiactiip varchar(15) [note: 'Dirección IP del usuario.']
  cregiactinave varchar(16) [note: 'Navegador usado por el usuario.']
  cregiactiregi text [not null, note: 'Descripción del registro/acción realizada.']
  cregiactisecu varchar(14) [not null, note: 'Secuencia/código de la actividad.']
  cusuaid int [not null, note: 'Usuario que realizó la actividad.']
  Note: 'Registro de actividades de los usuarios en la aplicación (auditoría).'
}

Table logic.tabmenu {
  cmenudesc text [not null, note: 'Descripción del menú.']
  cmenudest text [not null, note: 'Página de destino/inicio del menú.']
  cmenuesta int [not null, note: 'Estado del menú.']
  cmenuid int [pk, not null, note: 'Identificador único del menú.']
  cmenunomb text [not null, note: 'Nombre del menú.']
  cmenuorde int [note: 'Orden de visualización del menú.']
  Note: 'Menús (agrupadores de opciones) del sistema administrativo SAE.'
}

Table logic.tabopcimenu {
  copcimenudesc text [not null, note: 'Descripción de la opción.']
  copcimenuenla text [not null, note: 'Enlace/ruta de la opción.']
  copcimenuesta int [not null, note: 'Estado de la opción.']
  copcimenuicon text [not null, note: 'Icono de la opción.']
  copcimenuid int [pk, not null, note: 'Identificador único de la opción.']
  copcimenumenu int [not null, note: 'Menú padre (FK a tabmenu).']
  copcimenunomb text [not null, note: 'Nombre de la opción.']
  copcimenuorde int [not null, note: 'Orden de visualización.']
  Note: 'Opciones de menú (páginas/acciones) dentro de cada menú del SAE.'
}

Table logic.tabroll {
  cenlaid int [not null, note: 'Enlace de integración con la agenda (FK a integration.tabenla).']
  crolldesc text [not null, note: 'Descripción del rol.']
  crollesta int [not null, note: 'Estado del rol.']
  crollid int [pk, not null, note: 'Identificador único del rol.']
  crollnomb varchar(20) [not null, note: 'Nombre del rol.']
  crollpagientr text [not null, note: 'Página de inicio del rol.']
  Note: 'Roles del SAE (administrador, estudiante, docente, institución, acudiente, coordinador, secretaria).'
}

Table logic.tabrollopci {
  copcimenuid int [not null, note: 'Opción de menú (FK a tabopcimenu).']
  crollid int [not null, note: 'Rol (FK a tabroll).']
  crollopciesta int [default: '1', note: 'Estado del privilegio (1=activo).']
  crollopciid int [pk, not null, note: 'Identificador único del privilegio.']
  Note: 'Privilegios por rol: opciones de menú accesibles para cada rol.'
}

Table logic.tabusua {
  cusuaesta int [not null, note: 'Estado del usuario.']
  cusuaid int [pk, not null, note: 'Identificador único del usuario.']
  cusuallave text [not null, note: 'Clave/password del usuario.']
  cusuanick text [not null, note: 'Nick/usuario de login.']
  cusuanomb text [not null, note: 'Nombre del usuario.']
  cusuaroll int [not null, note: 'Rol del usuario (FK a tabroll).']
  indexes {
    (cusuaesta, cusuanick) [unique]
  }
  Note: 'Usuarios del SAE (login).'
}

Table logic.tabusuaopci {
  cusuaopciesta int [default: '1', note: 'Estado del privilegio (1=activo).']
  cusuaopciid int [pk, not null, note: 'Identificador único del privilegio.']
  cusuaopciopcimenu int [not null, note: 'Opción de menú (FK a tabopcimenu).']
  cusuaopciusua int [not null, note: 'Usuario (FK a tabusua).']
  Note: 'Privilegios por usuario: opciones de menú adicionales para un usuario específico.'
}

Table migracion.map_docente {
  aedocentes_id double [pk, not null]
  cdoceid int [not null]
}

Table migracion.map_estudiante {
  aeestudiantes_id int [pk, not null]
  cestuid int [not null]
}

Table migracion.map_institucion {
  aeinst_id double [pk, not null]
  cinstid int [not null]
}

Table migracion.map_rol {
  aeroll_id int [not null]
  crollid int [pk, not null]
}

Table migracion.map_usuario {
  aeusu_id double [not null]
  cusuaid int [pk, not null]
}

Table observador.tabobsplan {
  cestaobsplan int [not null, default: '8', note: 'Estado de la plantilla (8=activo).']
  cinstid int [not null, note: 'Institución a la que pertenece la plantilla (FK a public.tabinst).']
  cobsplanid int [pk, not null, note: 'Identificador único de la plantilla.']
  cparrobsplan1 text [note: 'Primer párrafo del contenido común.']
  cparrobsplan2 text [note: 'Segundo párrafo del contenido común.']
  ctituobsplan varchar(100) [note: 'Título de la plantilla del observador.']
  Note: 'Plantilla institucional con el contenido común del documento de observación del estudiante.'
}

Table observador.tabresp {
  cinstid int [not null, note: 'Institución (FK a public.tabinst).']
  cpespdesc text [note: 'Descripción del grupo de responsabilidades.']
  cpespnomb varchar(100) [note: 'Nombre del grupo de responsabilidades.']
  crespesta int [not null, default: '8', note: 'Estado del grupo (8=activo).']
  crespid int [pk, not null, note: 'Identificador único del grupo de responsabilidades.']
  Note: 'Grupos de responsabilidades (aspectos) de los estudiantes a observar, por institución.'
}

Table observador.tabrespeval {
  cevalsubid int [not null, note: 'Criterio de evaluación usado (FK a public.tabevalsub).']
  cmatrid int [not null, note: 'Matrícula del estudiante (FK a public.tabmatr).']
  cperiid int [not null, note: 'Periodo académico evaluado.']
  crespevalesta int [not null, default: '8', note: 'Estado de la evaluación (8=activo).']
  crespevalfech timestamp(6) without time zone [not null, note: 'Fecha de la evaluación.']
  crespevalhist text [note: 'Historial/notas de la evaluación.']
  crespevalid int [pk, not null, note: 'Identificador único de la evaluación.']
  crespsubid int [not null, note: 'Responsabilidad evaluada (FK a tabrespsub).']
  indexes {
    (cmatrid, crespsubid, cperiid) [unique]
  }
  Note: 'Resultado de la evaluación de cada aspecto/responsabilidad por estudiante y periodo.'
}

Table observador.tabrespobs {
  cmatrid int [not null, note: 'Matrícula del estudiante observado (FK a public.tabmatr).']
  cperiid int [not null, note: 'Periodo académico de la observación.']
  crespid int [not null, note: 'Grupo de responsabilidades (FK a tabresp).']
  crespobsdesc text [note: 'Descripción de la observación.']
  crespobsesta int [not null, default: '8', note: 'Estado de la observación (8=activo).']
  crespobsfech timestamp(6) without time zone [not null, note: 'Fecha de la observación.']
  crespobshist text [note: 'Historial/notas adicionales de la observación.']
  crespobsid int [pk, not null, default: 'nextval(\'observador.tabrespobs_crespobsid_seq\'::regclass)', note: 'Identificador único de la observación.']
  Note: 'Observaciones por estudiante para cada responsabilidad/aspecto (bitácora de clases y disciplina).'
}

Table observador.tabrespsub {
  crespid int [not null, note: 'Grupo de responsabilidades padre (FK a tabresp).']
  crespsubdesc text [note: 'Descripción de la responsabilidad.']
  crespsubesta int [not null, default: '8', note: 'Estado de la responsabilidad (8=activo).']
  crespsubid int [pk, not null, default: 'nextval(\'observador.tabrespsub_crespsubid_seq\'::regclass)', note: 'Identificador único de la responsabilidad.']
  crespsubnomb varchar(200) [note: 'Nombre de la responsabilidad.']
  Note: 'Responsabilidades (subaspectos) concretas de los estudiantes a observar, pertenecientes a un grupo.'
}

Table preescolar.tabpreambi {
  cambicode text [note: 'Código del ámbito.']
  cambicome text [note: 'Comentario/nota del ámbito.']
  cambidesc text [note: 'Descripción del ámbito.']
  cambiesta int [not null, note: 'Estado del ámbito.']
  cambiid int [pk, not null, note: 'Identificador único del ámbito.']
  Note: 'Ámbitos de desarrollo para preescolar.'
}

Table preescolar.tabpreasig {
  cambiid int [not null, note: 'Ámbito (FK a tabpreambi).']
  casigdura int [note: 'Duración de la asignación.']
  ccursid int [not null, note: 'Curso (FK a public.tabcurs).']
  cdimeid int [not null, note: 'Dimensión (FK a tabpredime).']
  cdoceid int [not null, note: 'Docente a cargo (FK a public.tabdoce).']
  cpreasigfechregi date [not null, note: 'Fecha de registro de la asignación.']
  cpreasiggradfina time(6) without time zone [note: 'Grado final de la asignación.']
  cpreasiggradinic time(6) without time zone [note: 'Grado inicial de la asignación.']
  cpreasigid int [pk, not null, note: 'Identificador único de la asignación.']
  cpreasigsesta int [not null, default: '8', note: 'Estado de la asignación (8=activo).']
  indexes {
    (cambiid, cdimeid, ccursid) [unique]
  }
  Note: 'Asignaciones de preescolar: relación ámbito + dimensión + curso + docente.'
}

Table preescolar.tabpredime {
  cdimeabre varchar(4) [note: 'Abreviatura de la dimensión (única).']
  cdimecode text [note: 'Código de la dimensión.']
  cdimecome text [note: 'Comentario/nota de la dimensión.']
  cdimedesc text [note: 'Descripción de la dimensión.']
  cdimeesta int [not null, note: 'Estado de la dimensión.']
  cdimeid int [pk, not null, note: 'Identificador único de la dimensión.']
  Note: 'Dimensiones de desarrollo dentro de los ámbitos de preescolar.'
}

Table preescolar.tabprenota {
  ccompid int [not null, note: 'Competencia evaluada (FK a public.tabcomp).']
  cmatrid int [not null, note: 'Matrícula del estudiante (FK a public.tabmatr).']
  cperiid int [not null, note: 'Periodo académico.']
  cpreasigid int [not null, note: 'Asignación de preescolar (FK a tabpreasig).']
  cprenotaesta int [not null, default: '8', note: 'Estado de la nota (8=activo).']
  cprenotafech date [not null, note: 'Fecha de la nota.']
  cprenotafechregi timestamp(6) without time zone [not null, note: 'Fecha de registro de la nota.']
  cprenotaid int [pk, not null, default: 'nextval(\'preescolar.tabprenota_cprenotaid_seq\'::regclass)', note: 'Identificador único de la nota.']
  cprenotaobse text [note: 'Observación de la nota.']
  cprenotavalo double [not null, note: 'Valor de la nota.']
  indexes {
    (cprenotaesta, cpreasigid, ccompid, cperiid, cmatrid) [unique]
  }
  Note: 'Notas/evaluaciones de preescolar por asignación, competencia, periodo y matrícula.'
}

Table preescolar.tabprenove {
  cmatrid int [not null, note: 'Matrícula del estudiante (FK a public.tabmatr).']
  cperiid int [not null, note: 'Periodo académico (FK a public.anolperi).']
  cpreasigid int [not null, note: 'Asignación de preescolar (FK a tabpreasig).']
  cprenoveesta int [not null, default: '1', note: 'Estado de la novedad.']
  cprenovefech date [not null, note: 'Fecha de la novedad.']
  cprenovefechregi timestamp(6) without time zone [not null, note: 'Fecha de registro de la novedad.']
  cprenoveid int [pk, not null, default: 'nextval(\'tabla_id_seq\'::regclass)', note: 'Identificador único de la novedad.']
  cprenoveobse text [note: 'Observación de la novedad.']
  cpretiponoveid int [not null, note: 'Tipo de novedad (FK a public.tabtiponove).']
  Note: 'Novedades (observaciones, asistencias, etc.) de preescolar por asignación, periodo y matrícula.'
}

Table public.aeconsultas {
  aeconsultas_contenido text [not null, note: 'Contenido de la consulta.']
  aeconsultas_destino int [not null, note: 'Destinatario de la consulta.']
  aeconsultas_estado int [not null, note: 'Estado de la consulta.']
  aeconsultas_fpublicacion date [not null, note: 'Fecha de publicación.']
  aeconsultas_id int [not null, note: 'Identificador único de la consulta.']
  aeconsultas_usuario int [not null, note: 'Usuario que consulta.']
  Note: 'Consultas (mensajes) de usuarios en el SAE.'
}

Table public.aeconsultas_Inst {
  aeconsultas_contenido text [not null, note: 'Contenido de la consulta.']
  aeconsultas_destino int [not null, note: 'Destinatario.']
  aeconsultas_estado int [not null, note: 'Estado.']
  aeconsultas_fpublicacion date [not null, note: 'Fecha de publicación.']
  aeconsultas_id int [not null, note: 'Identificador único de la consulta.']
  aeconsultas_usuario int [not null, note: 'Usuario que consulta.']
  Note: 'Copia por institución de las consultas (aeconsultas).'
}

Table public.anolperi {
  anolperidesc text [not null, note: 'Descripción del periodo.']
  anolperiesta int [not null, note: 'Estado del registro.']
  anolperifechfina date [not null, note: 'Fecha de fin del periodo.']
  anolperifechinic date [not null, note: 'Fecha de inicio del periodo.']
  anolperifechregi timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  anolperiid int [pk, not null, note: 'Identificador único del registro.']
  anolperivalo double [note: 'Valor (porcentaje) del periodo.']
  canolid int [not null, note: 'Año lectivo (FK a tabanol).']
  cinstid int [not null, note: 'Institución (FK a tabinst).']
  cperiid int [not null, note: 'Periodo académico (FK a tabperi).']
  Note: 'Relación institución-año lectivo-periodos: define los periodos académicos de cada institución por año.'
}

Table public.asigcurs {
  asigcursid int [pk, not null, note: 'Identificador único del registro.']
  casigcursesta int [not null, default: '1', note: 'Estado del registro (1=activo).']
  casigcursfechregi date [not null, note: 'Fecha de registro.']
  casigdura double [note: 'Duración de la clase.']
  casiggradfina time(6) without time zone [note: 'Hora de fin de la clase.']
  casiggradinic time(6) without time zone [note: 'Hora de inicio de la clase.']
  casigid int [note: 'Asignatura (FK a tabasig).']
  ccursid int [note: 'Curso (FK a tabcurs).']
  cdoceid int [note: 'Docente que dicta (FK a tabdoce).']
  indexes {
    (ccursid, casigid, cdoceid) [unique]
  }
  Note: 'Asignaturas de un curso: relación asignatura + curso + docente (con horario).'
}

Table public.asigcurscomp {
  asigcurscompesta int [not null, default: '1', note: 'Estado del registro (1=activo).']
  asigcurscompid int [not null, note: 'Identificador único del registro.']
  asigcursid int [not null, note: 'Asignatura-curso (FK a asigcurs).']
  ccompid int [not null, note: 'Competencia (FK a tabcomp).']
  indexes {
    (asigcursid, ccompid) [unique]
  }
  Note: 'Competencias (logros) asociadas a una asignatura que pertenece a un curso.'
}

Table public.asigcurscontprog {
  asigcurscontprogesta int [not null, default: '1', note: 'Estado (1=activo).']
  asigcurscontprogid int [pk, not null, note: 'Identificador único del registro.']
  asigcursid int [not null, note: 'Asignatura-curso (FK a asigcurs).']
  casigcurscontprogfech date [not null, note: 'Fecha del registro.']
  casigcurscontprogfechregi timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  ccontprogid int [not null, note: 'Contenido programático (FK a tabcontprog).']
  indexes {
    (asigcursid, ccontprogid) [unique]
  }
  Note: 'Contenido programático de una asignatura que pertenece a un curso.'
}

Table public.avisrolldest {
  cavisrolldestesta int [not null, note: 'Estado del registro.']
  cavisrolldestid int [pk, not null, note: 'Identificador único del registro.']
  cavisrollid int [not null, note: 'Aviso (FK a tabavisroll).']
  cavisusuadest int [not null, note: 'Usuario destino (creador).']
  cavisusuafechfina date [not null, note: 'Fecha de fin de vigencia del aviso.']
  cavisusuafechinic date [not null, note: 'Fecha de inicio de vigencia del aviso.']
  cavisusuafechregi timestamp(6) without time zone [not null, note: 'Fecha de registro.']
  crollid int [not null, note: 'Rol destinatario (FK a logic.tabroll).']
  Note: 'Tabla intermedia de avisos y roles: destinatarios (por rol) de cada aviso publicado.'
}

