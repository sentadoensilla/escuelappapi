# ============================================================
# .env.example — Escuelapp API (Node/Express)
# ------------------------------------------------------------
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas el `.env` real a git (contiene credenciales).
#
# La app soporta DOS modos de conexión a PostgreSQL:
#   - LOCAL  → base bdsae2 en localhost, sin SSL (bloque activo)
#   - REMOTO → servidor externo con SSL y certificados (comentado)
# Activa/desactiva el bloque según dónde estés trabajando.
# ============================================================

# ---------- Servidor HTTP ----------
PORT=4004
HOST=0.0.0.0
NODE_ENV=development            # development | production
APP_KEY=clave-secreta-cambiar
APP_API_NAME='Escuelapp API'
APP_API_FRONT=http://localhost:3000
APP_API_BACKEND=http://localhost:4004

# ---------- Conexión a la base (driver) ----------
DB_CONNECTION=postgres

# ============ CONEXIÓN LOCAL (desarrollo) ============
PG_HOST=localhost
PG_PORT=5432
PG_DB_NAME=bdsae2
PG_USER=usuario_local
PG_PASSWORD=cambiar-contraseña-local
PG_DIALECT=postgres
POOL_MAX=10
POOL_MIN=0
POOL_ACQUIRE=30000
POOL_IDLE=10000

# ============ CONEXIÓN REMOTA (servidor) ============
# Descomenta este bloque y comenta el LOCAL cuando uses la BD remota.
# PG_HOST=db.servidor.com
# PG_PORT=5432
# PG_DB_NAME=bdsae2
# PG_USER=usuario_remoto
# PG_PASSWORD=cambiar-contraseña-remota
# PG_DIALECT=postgres
# POOL_MAX=10
# POOL_MIN=0
# POOL_ACQUIRE=30000
# POOL_IDLE=10000
# PG_CERT=/ruta/al/cert.crt
# PG_CERT_KEY=/ruta/al/cert.key
# PG_CERT_CA=/ruta/al/ca.pem

# ---------- WhatsApp / sesiones de emisores ----------
APP_WP_SESSION_PATH=/ruta/donde/se/guardan/las/sesiones
APP_WP_SESSION_RELATIVE_PATH=sesiones
APP_WP_CUSTOMERS=57xxxxxxxx          # números autorizados (separados por coma)
APP_WP_NUMBERTEST=57xxxxxxxx         # número de pruebas

# ---------- MongoDB (NO usado por la app principal; opcional) ----------
# MONGODB_URI_SERVER=
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=bdsae2

# ---------- JWT (firma de tokens de sesión y enlaces seguros) ----------
JWT_PRIVATE_key=cambiar-clave-jwt

# ---------- Correo (nodemailer) ----------
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=notificaciones@ejemplo.com
MAIL_PASS=cambiar-contraseña-mail
