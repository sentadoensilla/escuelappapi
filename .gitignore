# ============================================================
# Escuelapp API — .gitignore
# ============================================================

# Node
node_modules/

# Entorno / secretos (NUNCA subir el .env real)
.env
.env.*
.envsae
!.env.example
database/ssl/

# Logs
*.log

# Credenciales de servicios (NUNCA subir: contienen claves privadas)
# Service accounts de Firebase/Google — cualquiera de estos *.json tiene private_key
utils/notifications/push/*.json

# Datos personales / uploads de usuarios
public/archivos/
notas.txt
observacionesSend.json
Asistencias_*.xlsx

# Backups / temporales / scratch
*.este
*.orig
*.bk
*.old
*.bak
*.tmp
package.16.json
package-lock.json.este
references/

# Repo embebido accidental (clone del propio api)
saescuelappapi/
